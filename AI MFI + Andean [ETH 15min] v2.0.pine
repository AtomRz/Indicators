//@version=5
indicator("AI MFI + Andean [ETH 15min] v2.0", overlay=true)

mfi_len      = input.int(6, "MFI Length")
mfi_training = input.int(200, "AI Training Size")
and_len      = input.int(20, "Andean Oscillator Length")
and_sig_len  = input.int(7, "Andean Signal Smoothing")
lookback     = input.int(5, "Confirmation Window")
ema_len      = input.int(200, "EMA Length")
show_ema     = input.bool(false, "Show EMA")
tp_mult      = input.float(3.0, "Fixed Take Profit (xATR)")
sl_mult      = input.float(1.5, "Initial Stop Loss (xATR)")
show_sl_tp   = input.bool(true, "Show SL/TP Lines")
use_trailing = input.bool(true, "Enable Trailing Stop")
trail_atr_mult = input.float(1.5, "Trailing Stop ATR Multiplier")
use_trend    = input.bool(true, "Trend Filter")
use_atr      = input.bool(true, "ATR Filter")
atr_period   = input.int(14, "ATR Period")
atr_min      = input.float(0.25, "Min ATR %")
atr_max      = input.float(3.0, "Max ATR %")
show_table   = input.bool(true, "Show Table")
table_pos    = input.string("Top Right", "Table Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"])

get_table_position(pos_str) =>
    switch pos_str
        "Top Right" => position.top_right
        "Top Left" => position.top_left
        "Bottom Right" => position.bottom_right
        "Bottom Left" => position.bottom_left
        => position.top_right
table_position = get_table_position(table_pos)

ema200 = ta.ema(close, ema_len)
plot(show_ema ? ema200 : na, "EMA 200", color=color.new(#ffffff, 40), linewidth=2)

osc_mfi = ta.mfi(hlc3, mfi_len)
kmeans_clustering(src, training_len) =>
    safe_len = math.min(training_len, bar_index)
    values = array.new_float(0)
    for i = safe_len to 0
        array.push(values, src[i])
    if array.size(values) < 2
        [array.avg(values), array.avg(values)]
    else
        c1 = array.get(values, 0)
        c2 = array.get(values, array.size(values)-1)
        for _ = 0 to 4
            cl1 = array.new_float(0)
            cl2 = array.new_float(0)
            for i = 0 to array.size(values)-1
                v = array.get(values, i)
                if math.abs(v-c1) < math.abs(v-c2)
                    array.push(cl1, v)
                else
                    array.push(cl2, v)
            c1 := array.size(cl1)>0 ? array.avg(cl1) : c1
            c2 := array.size(cl2)>0 ? array.avg(cl2) : c2
        [c1, c2]

[c1, c2] = kmeans_clustering(osc_mfi, mfi_training)
level_os = math.min(c1,c2)
level_ob = math.max(c1,c2)
mfi_bull_sig = ta.crossover(osc_mfi, level_os) and barstate.isconfirmed
mfi_bear_sig = ta.crossunder(osc_mfi, level_ob) and barstate.isconfirmed

alpha = 2 / (and_len + 1)
var float up1=na, var float up2=na, var float dn1=na, var float dn2=na
up1 := nz(math.max(close, open, up1 - (up1 - close) * alpha), close)
up2 := nz(math.max(close * close, open * open, up2 - (up2 - close * close) * alpha), close*close)
dn1 := nz(math.min(close, open, dn1 + (close - dn1) * alpha), close)
dn2 := nz(math.min(close * close, open * open, dn2 + (close * close - dn2) * alpha), close*close)
and_osc = math.sqrt(math.max(0, dn2 - dn1*dn1)) - math.sqrt(math.max(0, up2 - up1*up1))
and_sig = ta.ema(and_osc, and_sig_len)
and_bull_sig = ta.crossover(and_osc, and_sig) and barstate.isconfirmed
and_bear_sig = ta.crossunder(and_osc, and_sig) and barstate.isconfirmed

atr_val = ta.atr(atr_period)
atr_pct = (atr_val / close) * 100
atr_ok = use_atr ? (atr_pct >= atr_min and atr_pct <= atr_max) : true
is_uptrend = close > ema200
is_downtrend = close < ema200
trend_ok_long = use_trend ? is_uptrend : true
trend_ok_short = use_trend ? is_downtrend : true

long_signal_raw = (mfi_bull_sig and ta.barssince(and_bull_sig)<=lookback) or (and_bull_sig and ta.barssince(mfi_bull_sig)<=lookback)
short_signal_raw = (mfi_bear_sig and ta.barssince(and_bear_sig)<=lookback) or (and_bear_sig and ta.barssince(mfi_bear_sig)<=lookback)
long_signal = long_signal_raw and trend_ok_long and atr_ok
short_signal = short_signal_raw and trend_ok_short and atr_ok

var float long_entry = na
var float long_trail = na
var bool in_long = false
var float short_entry = na
var float short_trail = na
var bool in_short = false
var float fix_atr = na

if long_signal
    in_long := true
    long_entry := close
    fix_atr := atr_val
    long_trail := close - (fix_atr * sl_mult)
else if in_long
    if high >= (long_entry + (fix_atr * tp_mult))
        in_long := false
    trail_dist = use_trailing ? (fix_atr * trail_atr_mult) : (fix_atr * sl_mult)
    long_trail := math.max(long_trail, close - trail_dist)
    if close <= long_trail
        in_long := false

if short_signal
    in_short := true
    short_entry := close
    fix_atr := atr_val
    short_trail := close + (fix_atr * sl_mult)
else if in_short
    if low <= (short_entry - (fix_atr * tp_mult))
        in_short := false
    trail_dist = use_trailing ? (fix_atr * trail_atr_mult) : (fix_atr * sl_mult)
    short_trail := math.min(short_trail, close + trail_dist)
    if close >= short_trail
        in_short := false

long_init_sl = show_sl_tp and in_long and not na(long_entry) ? long_entry - (fix_atr * sl_mult) : na
long_tp      = show_sl_tp and in_long and not na(long_entry) ? long_entry + (fix_atr * tp_mult) : na
short_init_sl = show_sl_tp and in_short and not na(short_entry) ? short_entry + (fix_atr * sl_mult) : na
short_tp      = show_sl_tp and in_short and not na(short_entry) ? short_entry - (fix_atr * tp_mult) : na
long_trail_plot = in_long and use_trailing ? long_trail : na
short_trail_plot = in_short and use_trailing ? short_trail : na

plotshape(long_signal, "BUY", shape.triangleup, location.belowbar, color.lime, size=size.small)
plotshape(short_signal, "SELL", shape.triangledown, location.abovebar, color.red, size=size.small)
plot(long_init_sl, "Long Initial SL", color=color.red, style=plot.style_cross, linewidth=2)
plot(long_tp, "Long TP", color=color.lime, style=plot.style_cross, linewidth=2)
plot(short_init_sl, "Short Initial SL", color=color.red, style=plot.style_cross, linewidth=2)
plot(short_tp, "Short TP", color=color.lime, style=plot.style_cross, linewidth=2)
plot(long_trail_plot, "Long Trailing Stop", color=color.yellow, style=plot.style_circles, linewidth=1)
plot(short_trail_plot, "Short Trailing Stop", color=color.purple, style=plot.style_circles, linewidth=1)

var table tbl = na
if show_table and barstate.islast
    tbl := table.new(table_position, 2, 7, bgcolor=color.new(color.black, 70), border_width=1, border_color=color.gray)
    table.cell(tbl, 0, 0, "Trend:", text_color=color.white)
    table.cell(tbl, 1, 0, is_uptrend ? "BULL" : "BEAR", text_color=is_uptrend ? color.lime : color.red)
    table.cell(tbl, 0, 1, "ATR Vol:", text_color=color.white)
    table.cell(tbl, 1, 1, str.tostring(atr_pct, "#.##") + "%", text_color=atr_ok ? color.yellow : color.red)
    table.cell(tbl, 0, 2, "MFI AI:", text_color=color.white)
    table.cell(tbl, 1, 2, str.tostring(osc_mfi, "#.#"), text_color=color.yellow)
    table.cell(tbl, 0, 3, "Long state:", text_color=color.white)
    table.cell(tbl, 1, 3, in_long ? "IN" : "-", text_color=in_long ? color.lime : color.gray)
    table.cell(tbl, 0, 4, "Short state:", text_color=color.white)
    table.cell(tbl, 1, 4, in_short ? "IN" : "-", text_color=in_short ? color.red : color.gray)
    table.cell(tbl, 0, 5, "L-Trail:", text_color=color.white)
    table.cell(tbl, 1, 5, in_long ? str.tostring(long_trail, "#.##") : "-", text_color=color.yellow)
    table.cell(tbl, 0, 6, "S-Trail:", text_color=color.white)
    table.cell(tbl, 1, 6, in_short ? str.tostring(short_trail, "#.##") : "-", text_color=color.purple)
