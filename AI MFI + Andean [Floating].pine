//@version=5
indicator("AI MFI + Andean [Floating]", overlay=true)

// =============================
// SETTINGS
// =============================
mfi_grp      = "AI MFI Settings"
mfi_len      = input.int(8, "MFI Length", group=mfi_grp)
mfi_training = input.int(300, "AI Training Size", group=mfi_grp)
long_sens    = input.float(30.0, "Long Sensitivity (Oversold)", group=mfi_grp)
short_sens   = input.float(70.0, "Short Sensitivity (Overbought)", group=mfi_grp)

and_grp      = "Andean Oscillator Settings"
and_len      = input.int(30, "Andean Length", group=and_grp)
and_sig_len  = input.int(13, "Signal Smoothing", group=and_grp)

logic_grp    = "Strategy Logic"
lookback     = input.int(5, "Confirmation Window", group=logic_grp)
ema_len      = input.int(200, "EMA Trend Filter", group=logic_grp)

risk_grp     = "Visual SL/TP (ATR)"
tp_mult      = input.float(2.0, "Take Profit Multiplier", group=risk_grp)
sl_mult      = input.float(1.0, "Stop Loss Multiplier", group=risk_grp)

filter_grp   = "Filter Settings"
use_trend    = input.bool(true, "Use Trend Filter", group=filter_grp)
use_atr      = input.bool(true, "Use ATR Filter", group=filter_grp)
atr_period   = input.int(14, "ATR Period", group=filter_grp)
atr_min      = input.float(0.5, "Min ATR %", group=filter_grp, minval=0.1, step=0.1)
atr_max      = input.float(3.0, "Max ATR %", group=filter_grp, minval=1.0, step=0.1)

table_grp    = "Table Settings"
table_pos    = input.string("Top Right", "Table Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group=table_grp)
show_table   = input.bool(true, "Show Statistics Table", group=table_grp)
show_atr_debug = input.bool(true, "Show ATR Debug Info", group=table_grp)

get_table_position(pos_str) =>
    switch pos_str
        "Top Right" => position.top_right
        "Top Left" => position.top_left
        "Bottom Right" => position.bottom_right
        "Bottom Left" => position.bottom_left
        => position.top_right

table_position = get_table_position(table_pos)

// --- INDICATORS ---
ema200 = ta.ema(close, ema_len)
osc_mfi = ta.mfi(hlc3, mfi_len)

// =============================
// K-MEANS CLUSTERING
// =============================
kmeans_clustering(src, training_len) =>
    safe_len = math.min(training_len, bar_index)
    values = array.new_float(0)
    
    for i = safe_len to 0
        array.push(values, src[i])
    
    if array.size(values) < 2
        [array.avg(values), array.avg(values)]
    else
        c1 = array.get(values, 0)
        c2 = array.get(values, array.size(values) - 1)
        
        for iter = 0 to 2
            cl1 = array.new_float(0)
            cl2 = array.new_float(0)
            
            for i = 0 to array.size(values) - 1
                val = array.get(values, i)
                if math.abs(val - c1) < math.abs(val - c2)
                    array.push(cl1, val)
                else
                    array.push(cl2, val)
            
            c1 := array.size(cl1) > 0 ? array.avg(cl1) : c1
            c2 := array.size(cl2) > 0 ? array.avg(cl2) : c2
            
            array.clear(cl1)
            array.clear(cl2)
        
        [c1, c2]

[c1, c2] = kmeans_clustering(osc_mfi, mfi_training)
level_os = math.min(c1, c2)
level_ob = math.max(c1, c2)

mfi_bull_sig = ta.crossover(osc_mfi, level_os) and barstate.isconfirmed
mfi_bear_sig = ta.crossunder(osc_mfi, level_ob) and barstate.isconfirmed

// =============================
// ANDEAN OSCILLATOR
// =============================
alpha = 2 / (and_len + 1)
var float up1 = 0.0, var float up2 = 0.0, var float dn1 = 0.0, var float dn2 = 0.0

up1 := nz(math.max(close, open, up1 - (up1 - close) * alpha), close)
up2 := nz(math.max(close * close, open * open, up2 - (up2 - close * close) * alpha), close * close)
dn1 := nz(math.min(close, open, dn1 + (close - dn1) * alpha), close)
dn2 := nz(math.min(close * close, open * open, dn2 + (close * close - dn2) * alpha), close * close)

and_osc = math.sqrt(math.max(0, dn2 - dn1 * dn1)) - math.sqrt(math.max(0, up2 - up1 * up1))
and_sig = ta.ema(and_osc, and_sig_len)

and_bull_sig = ta.crossover(and_osc, and_sig) and barstate.isconfirmed
and_bear_sig = ta.crossunder(and_osc, and_sig) and barstate.isconfirmed

// =============================
// ATR FILTER
// =============================
atr_val = ta.atr(atr_period)
atr_pct = (atr_val / close) * 100

atr_check_min = atr_pct >= atr_min
atr_check_max = atr_pct <= atr_max
atr_ok = use_atr ? (atr_check_min and atr_check_max) : true

// =============================
// TREND FILTER
// =============================
is_uptrend = close > ema200
is_downtrend = close < ema200
trend_ok_long = use_trend ? is_uptrend : true
trend_ok_short = use_trend ? is_downtrend : true

// =============================
// FINAL SIGNALS
// =============================
long_signal_raw = (mfi_bull_sig and ta.barssince(and_bull_sig) <= lookback) or (and_bull_sig and ta.barssince(mfi_bull_sig) <= lookback)
short_signal_raw = (mfi_bear_sig and ta.barssince(and_bear_sig) <= lookback) or (and_bear_sig and ta.barssince(mfi_bear_sig) <= lookback)

long_before_atr = long_signal_raw and trend_ok_long
short_before_atr = short_signal_raw and trend_ok_short

long_signal = long_before_atr and atr_ok
short_signal = short_before_atr and atr_ok

// =============================
// VISUALIZATION - RELATIVE POSITIONING
// =============================
// Используем location.belowbar и location.abovebar (относительные, не абсолютные)
plotshape(long_signal, "BUY", shape.labelup, location.belowbar, #00ff00, size=size.small, text="BUY", textcolor=#000000)
plotshape(short_signal, "SELL", shape.labeldown, location.abovebar, #ff0000, size=size.small, text="SELL", textcolor=#ffffff)

// SL/TP линии - привязаны к цене (движутся с графиком)
plot(long_signal ? low - atr_val * sl_mult : na, "Long SL", color=#ff0000, style=plot.style_cross, linewidth=2)
plot(long_signal ? high + atr_val * tp_mult : na, "Long TP", color=#00ff00, style=plot.style_cross, linewidth=2)
plot(short_signal ? high + atr_val * sl_mult : na, "Short SL", color=#ff0000, style=plot.style_cross, linewidth=2)
plot(short_signal ? low - atr_val * tp_mult : na, "Short TP", color=#00ff00, style=plot.style_cross, linewidth=2)

// =============================
// STATS
// =============================
var int total = 0
var int wins = 0
var int losses = 0
var int filtered_by_atr = 0

if long_signal_raw or short_signal_raw
    if (long_before_atr or short_before_atr) and not (long_signal or short_signal)
        filtered_by_atr := filtered_by_atr + 1

if long_signal or short_signal
    total := total + 1
    if long_signal
        if ta.highest(high, 15) > close + atr_val * tp_mult
            wins := wins + 1
        else if ta.lowest(low, 15) < close - atr_val * sl_mult
            losses := losses + 1
    if short_signal
        if ta.lowest(low, 15) < close - atr_val * tp_mult
            wins := wins + 1
        else if ta.highest(high, 15) > close + atr_val * sl_mult
            losses := losses + 1

// =============================
// TABLE
// =============================
var table tbl = na

if show_table
    if na(tbl)
        rows = show_atr_debug ? 7 : 4
        tbl := table.new(table_position, 2, rows, bgcolor=color.new(#000000, 70), border_color=#808080)
    
    if barstate.islast
        wr = total > 0 ? (wins / total * 100) : 0
        
        table.cell(tbl, 0, 0, "Trend:", text_color=#ffffff)
        table.cell(tbl, 1, 0, is_uptrend ? "BULL" : "BEAR", text_color=is_uptrend ? #00ff00 : #ff0000)
        
        table.cell(tbl, 0, 1, "Volatility:", text_color=#ffffff)
        table.cell(tbl, 1, 1, str.tostring(atr_pct, "#.##") + "%", text_color=atr_ok ? #ffff00 : #ff0000)
        
        table.cell(tbl, 0, 2, "Signals:", text_color=#ffffff)
        table.cell(tbl, 1, 2, str.tostring(total), text_color=#ffff00)
        
        table.cell(tbl, 0, 3, "Win %:", text_color=#ffffff)
        table.cell(tbl, 1, 3, str.tostring(wr, "#.#") + "%", text_color=wr > 50 ? #00ff00 : #ff8800)
        
        if show_atr_debug
            table.cell(tbl, 0, 4, "ATR Filter:", text_color=#ffffff)
            atr_status = use_atr ? (atr_ok ? "✓ ON" : "✗ BLOCKED") : "✗ OFF"
            table.cell(tbl, 1, 4, atr_status, text_color=use_atr ? (atr_ok ? #00ff00 : #ff0000) : #808080)
            
            table.cell(tbl, 0, 5, "ATR Range:", text_color=#ffffff)
            table.cell(tbl, 1, 5, str.tostring(atr_min, "#.##") + "% - " + str.tostring(atr_max, "#.##") + "%", text_color=#00ffff)
            
            table.cell(tbl, 0, 6, "Filtered by ATR:", text_color=#ffffff)
            table.cell(tbl, 1, 6, str.tostring(filtered_by_atr), text_color=#ff8800)
