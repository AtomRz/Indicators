//@version=6

indicator("MUFCA [AtomDC] v5 - Elite", overlay = true, max_labels_count = 500, max_bars_back = 500, max_lines_count = 500, max_boxes_count = 500)

// ═════════════════════════════════════════════════════════════════════════════
// v5 — aligned with mufca-bot (signals.py / indicators.py / state.py)
//   + Adaptive SL (MAE percentile) and adaptive TP1/TP2 (weighted MFE percentile,
//     hit-rate feedback, regime discount, capture rate, ATR cap) learned from the
//     indicator's own closed trades per track/side — same algorithm as state.py
//   + TP1 (50%) -> SL moved per TP1 mode, same-bar TP1/SL policy, 20-bar time stop
//   + Cooldown armed on EXIT (not entry), per track and side
//   + Hurst: Anis-Lloyd bias correction, bot default windows
//   + CHOP threshold per timeframe, K-Means MFI retrained every bar on closed bars,
//     MFI crossovers evaluated against the current level (as live does)
//   + HTF bias from the last CLOSED higher-timeframe candle
//   - Removed: trailing stop, partial-TP hint (replaced by real TP1 logic)
//   - Removed: B-track (Breakout) — dropped from the bot too (signals too rare)
//   Not ported (need data the indicator does not have): on-chain/derivatives bias,
//   volume-flow leverage, TP obstacle cap (S/R + Volume Profile), spread gate,
//   pullback limit entry, relative-strength / volume-profile confidence components.
// ═════════════════════════════════════════════════════════════════════════════

// ═════════════════════════════════════════════════════════════════════════════
// 1. INPUTS
// ═════════════════════════════════════════════════════════════════════════════
sig_grp = "SIGNAL SOURCES"
enable_a = input.bool(true, "Enable A Signals (Andean + MFI)",
     tooltip = "Type A signals — Andean oscillator combined with MFI K-Means levels. Less frequent, more precise.",
     group = sig_grp)
enable_u = input.bool(true, "Enable U Signals (UT Bot)",
     tooltip = "Type U signals — ATR trailing stop UT Bot. More frequent, reacts faster to reversals.",
     group = sig_grp)

filter_grp = "FILTER MODE"
use_frama_filter = input.bool(true, "Use FRAMA Filter",
     tooltip = "Allows A/U entries only in the direction of the FRAMA trend.",
     group = filter_grp)
use_chop = input.bool(true, "Use CHOP Filter",
     tooltip = "Blocks A/U signals during sideways markets (CHOP above the per-timeframe threshold, see CHOP FILTER group).",
     group = filter_grp)
use_atr_f = input.bool(true, "Use ATR Filter",
     tooltip = "Filters out markets that are too quiet or too chaotic. Applies to A and U.",
     group = filter_grp)
atr_period = input.int(14, "ATR Period",
     tooltip = "ATR period for the volatility filter (bot: 14).",
     group = filter_grp)
atr_min = input.float(0.3, "Min ATR %",
     tooltip = "Minimum volatility as a % of price (bot: 0.3).",
     group = filter_grp)
atr_max = input.float(4.5, "Max ATR %",
     tooltip = "Maximum volatility as a % of price (bot: 4.5). Above it the regime is CHAOS.",
     group = filter_grp)
use_hurst = input.bool(false, "Use Hurst Filter",
     tooltip = "Blocks signals when the market is close to a random walk, using a rolling R/S Hurst exponent of log-returns. Off by default, like in the bot. Computed once per closed bar.",
     group = filter_grp)
hurst_window_1h = input.int(261, "Hurst Window (1h chart)", minval = 18, maxval = 300,
     tooltip = "Bars for the rolling R/S estimate on a 1h chart. 261 = bot default (config.py). The optimal window is pair/timeframe specific.",
     group = filter_grp)
hurst_window_4h = input.int(146, "Hurst Window (4h chart)", minval = 18, maxval = 300,
     tooltip = "Bars for the rolling R/S estimate on a 4h chart. 146 = bot default (config.py).",
     group = filter_grp)
hurst_window_other = input.int(100, "Hurst Window (Other TF)", minval = 18, maxval = 300,
     tooltip = "Used for any chart timeframe other than 1h/4h. 100 = the bot's fallback for unknown timeframes.",
     group = filter_grp)
hurst_window = timeframe.period == "60" ? hurst_window_1h : timeframe.period == "240" ? hurst_window_4h : hurst_window_other
hurst_min_dev = input.float(0.05, "Hurst Min Deviation from 0.5",
     minval = 0.0, maxval = 0.5, step = 0.01,
     tooltip = "Trending Only: pass only if (hurst - 0.5) >= this. Symmetric: pass if abs(hurst - 0.5) >= this.",
     group = filter_grp)
hurst_mode = input.string("Trending Only", "Hurst Mode",
     options = ["Trending Only", "Symmetric (Trend + Mean-Rev)"],
     tooltip = "Trending Only matches the trend-following A/U entries (bot default).",
     group = filter_grp)
hurst_bias = input.bool(true, "Hurst Bias Correction (Anis-Lloyd)",
     tooltip = "Subtracts the slope that i.i.d. noise would produce over the same chunk sizes, so pure noise reads ~0.5 at any window. Bot default: on. Turn off to get the legacy (uncorrected) estimate.",
     group = filter_grp)
show_hurst_label = input.bool(false, "Show Hurst Debug Label",
     tooltip = "Shows the current Hurst exponent in the corner of the chart.",
     group = filter_grp)

ai_pro_grp = "AI PRO"
htf = input.timeframe("D", "HTF Bias TF",
