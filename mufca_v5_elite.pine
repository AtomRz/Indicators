// Derived constants
tp1_frac = tp1_mode == "breakeven" ? 0.0 : tp1_mode == "quarter_tp1" ? 0.25 : tp1_mode == "half_tp1" ? 0.5 : 0.75
hist_cap = sig_hist_limit * 3
chop_threshold = timeframe.period == "60" ? chop_thr_1h : timeframe.period == "240" ? chop_thr_4h : chop_thr_other

// ═════════════════════════════════════════════════════════════════════════════
// 2. HELPERS
// ═════════════════════════════════════════════════════════════════════════════
get_pos(pos_str) =>
    switch pos_str
        "Top Right"    => position.top_right
        "Top Left"     => position.top_left
        "Bottom Right" => position.bottom_right
        "Bottom Left"  => position.bottom_left
        => position.top_right

tbl_pos = get_pos(table_pos)

ma(source, length, _type) =>
    switch _type
        "SMA"         => ta.sma(source, length)
        "EMA"         => ta.ema(source, length)
        "SMMA (RMA)"  => ta.rma(source, length)
        "WMA"         => ta.wma(source, length)
        "VWMA"        => ta.vwma(source, length)
        => ta.sma(source, length)

// Stirling series for ln(Gamma(x)); chunk sizes are >= 8 so x >= 3.5 (error < 1e-7)
f_log_gamma(float x) =>
    (x - 0.5) * math.log(x) - x + 0.5 * math.log(2.0 * math.pi) + 1.0 / (12.0 * x) - 1.0 / (360.0 * x * x * x) + 1.0 / (1260.0 * math.pow(x, 5))

// Anis-Lloyd (1976) expected R/S of k i.i.d. observations (population std), as in indicators.py
f_exp_rs(int k) =>
    float s = 0.0
    for i = 1 to k - 1
        s += math.sqrt(float(k - i) / float(i))
    math.exp(f_log_gamma((k - 1) / 2.0) - f_log_gamma(k / 2.0)) / math.sqrt(math.pi) * s

// Rolling Hurst exponent via rescaled-range (R/S) analysis on log-returns.
// Port of indicators._hurst_rs(): 6 log-spaced chunk sizes (8 .. window/2), mean
// R/S per size, OLS slope of log(R/S) vs log(k); with `corr` the slope that i.i.d.
// noise would give (Anis-Lloyd) is subtracted and the result re-centred on 0.5.
f_hurst(int window, bool corr) =>
    float result = na
    if bar_index >= window
        array<float> ret = array.new<float>(window, 0.0)
        for i = 0 to window - 1
            array.set(ret, i, math.log(close[window - 1 - i] / close[window - i]))
        float mean_r = array.avg(ret)
        float var_r = 0.0
        for i = 0 to window - 1
            float d = array.get(ret, i) - mean_r
            var_r += d * d
        float std_r = math.sqrt(var_r / window)
        result := 0.5
        int max_k = int(window / 2)
        if std_r > 0.0 and max_k >= 8
            array<int> sizes = array.new<int>()
            float log_start = math.log(8.0)
            float step = (math.log(float(max_k)) - log_start) / 5.0
            int last_s = -1
            for i = 0 to 5
                int s = i == 0 ? 8 : i == 5 ? max_k : int(math.exp(log_start + step * i))
                if s >= 8 and s != last_s
                    array.push(sizes, s)
                    last_s := s
            if array.size(sizes) >= 2
                array<float> log_k = array.new<float>()
                array<float> log_rs = array.new<float>()
                array<float> log_e = array.new<float>()
                for si = 0 to array.size(sizes) - 1
                    int k = array.get(sizes, si)
                    int n_chunks = int(window / k)
                    if n_chunks >= 1
                        float rs_sum = 0.0
                        int rs_cnt = 0
                        for c = 0 to n_chunks - 1
                            int start = c * k
                            float cmean = 0.0
                            for j = 0 to k - 1
                                cmean += array.get(ret, start + j)
                            cmean := cmean / k
                            float cumsum = 0.0
                            float cmax = -1e18
                            float cmin = 1e18
                            float cvar = 0.0
                            for j = 0 to k - 1
                                float d2 = array.get(ret, start + j) - cmean
                                cumsum += d2
                                cmax := math.max(cmax, cumsum)
                                cmin := math.min(cmin, cumsum)
                                cvar += d2 * d2
                            float cstd = math.sqrt(cvar / k)
                            if cstd > 0.0
                                rs_sum += (cmax - cmin) / cstd
                                rs_cnt += 1
                        if rs_cnt > 0
                            array.push(log_k, math.log(float(k)))
                            array.push(log_rs, math.log(rs_sum / rs_cnt))
                            if corr
                                array.push(log_e, math.log(f_exp_rs(k)))
                if array.size(log_k) >= 2
                    float mx = array.avg(log_k)
                    float my = array.avg(log_rs)
                    float num = 0.0
                    float den = 0.0
                    for i = 0 to array.size(log_k) - 1
                        float dx = array.get(log_k, i) - mx
                        num += dx * (array.get(log_rs, i) - my)
                        den += dx * dx
                    if den != 0.0
                        float slope = num / den
                        if corr
                            float me = array.avg(log_e)
                            float num_e = 0.0
                            for i = 0 to array.size(log_k) - 1
                                num_e += (array.get(log_k, i) - mx) * (array.get(log_e, i) - me)
                            slope := slope - num_e / den + 0.5
                        result := math.max(0.0, math.min(1.0, slope))
    result

// 2-cluster K-Means on 1-D data, port of indicators.run_kmeans_mfi(): min/max init,
// up to 10 Lloyd iterations (stops early once converged — identical result),
// fallback 20/80 for degenerate input.
f_kmeans(array<float> vals) =>
    float c1 = 20.0
    float c2 = 80.0
    int n = array.size(vals)
    if n >= 2
        float a = array.min(vals)
        float b = array.max(vals)
        if b - a >= 1e-6
            float mean_all = array.avg(vals)
            for it = 1 to 10
                float s1 = 0.0
                float s2 = 0.0
                int n1 = 0
                int n2 = 0
                for i = 0 to n - 1
                    float v = array.get(vals, i)
                    if math.abs(v - a) <= math.abs(v - b)
                        s1 += v
                        n1 += 1
                    else
                        s2 += v
                        n2 += 1
                float na_ = n1 > 0 ? s1 / n1 : mean_all
                float nb_ = n2 > 0 ? s2 / n2 : mean_all
                bool same = na_ == a and nb_ == b
                a := na_
                b := nb_
                if same
                    break
            if math.abs(b - a) >= 1e-6
                c1 := a
                c2 := b
    [math.min(c1, c2), math.max(c1, c2)]

// Bars since a crossover/crossunder of `src` vs a FIXED level `lvl` within `lb` bars.
// Live bot re-evaluates the past crossovers against the CURRENT level (scalar), so do we.
f_bars_since_lvl(float src, float lvl, int lb, bool up) =>
    int res = 999
    for k = 0 to lb
        float a = src[k]
        float b = src[k + 1]
        bool c = up ? (a > lvl and b <= lvl) : (a < lvl and b >= lvl)
        if c and res == 999
            res := k
    res

// ═════════════════════════════════════════════════════════════════════════════
// 2b. TRADE ENGINE TYPES AND FUNCTIONS (ports of signals.py / state.py)
// ═════════════════════════════════════════════════════════════════════════════
// exit type codes: 0 tp, 1 sl, 2 sl_after_tp1, 3 cancelled (time stop)
type Hist
    array<float> mfe
    array<float> mae
    array<float> moved
    array<int>   etype
    array<int>   regime

type Trade
    bool   active          = false
    int    side            = 0
    float  entry           = na
    float  sl              = na
    float  tp1             = na
    float  tp2             = na
    bool   tp1_hit         = false
    int    entry_bar       = na
    float  atr_at          = na
    float  mfe             = 0.0
    float  mae             = 0.0
    int    regime          = 0
    int    lev             = 1
    string sl_src          = ""
    string tp_src          = ""
    int    last_exit_long  = na
    int    last_exit_short = na
    int    n               = 0
    int    wins            = 0
    float  pnl_sum         = 0.0
    bool   ev_tp1          = false
    int    ev_exit         = 0
    int    c_cand          = 0
    int    c_busy          = 0
    int    c_cd            = 0
    int    c_rej           = 0
    int    c_open          = 0

// Weighted percentile with the midpoint-CDF convention (state._weighted_percentile)
f_wpctl(array<float> vals, array<float> wts, float pct) =>
    float res = na
    int n = array.size(vals)
    if n == 1
        res := array.get(vals, 0)
    else if n > 1
        array<int> ord = array.sort_indices(vals, order.ascending)
        float tot = 0.0
        for i = 0 to n - 1
            tot += array.get(wts, i)
        if tot <= 0.0
            res := array.median(vals)
        else
            array<float> sv = array.new<float>()
            array<float> md = array.new<float>()
            float cum = 0.0
            for k = 0 to n - 1
                int j = array.get(ord, k)
                float w = array.get(wts, j)
                array.push(sv, array.get(vals, j))
                array.push(md, (cum + w / 2.0) / tot)
                cum += w
            if pct <= array.get(md, 0)
                res := array.get(sv, 0)
            else if pct >= array.get(md, n - 1)
                res := array.get(sv, n - 1)
            else
                res := array.get(sv, n - 1)
                bool found = false
                for i = 1 to n - 1
                    if not found and array.get(md, i) >= pct
                        float span = array.get(md, i) - array.get(md, i - 1)
                        float frac = span > 0.0 ? (pct - array.get(md, i - 1)) / span : 0.0
                        res := array.get(sv, i - 1) + frac * (array.get(sv, i) - array.get(sv, i - 1))
                        found := true
    res

// state.calculate_adaptive_tp(): returns [tp distance in %, is_fallback]
f_adaptive_tp(Hist h, float atr_val, float entry, int reg) =>
    float tp_pct = na
    bool fb = true
    int n_all = array.size(h.etype)
    if n_all >= 3
        int n_reg = 0
        for i = 0 to n_all - 1
            if array.get(h.regime, i) == reg
                n_reg += 1
        float disc = 1.0
        bool only_reg = false
        if n_reg >= 10
            only_reg := true
        else if n_reg >= 5
            disc := 0.85
        else
            disc := 0.75
        array<int> use_i = array.new<int>()
        for i = 0 to n_all - 1
            if not only_reg or array.get(h.regime, i) == reg
                array.push(use_i, i)
        int n_use = array.size(use_i)
        int s0 = math.max(0, n_use - sig_hist_limit)
        float pct = tp_percentile
        if tp_auto_adjust and n_use - s0 >= 15
            int tpc = 0
            int slc = 0
            int ptc = 0
            for q = s0 to n_use - 1
                int et = array.get(h.etype, array.get(use_i, q))
                if et == 0
                    tpc += 1
                else if et == 1
                    slc += 1
                else if et == 2
                    ptc += 1
            int tot = tpc + slc + ptc
            float rate = tot > 0 ? (tpc + 0.5 * ptc) / tot : 0.0
            float adj = 0.0
            if rate < tp_hit_target * 0.7
                adj := -0.12
            else if rate < tp_hit_target * 0.9
                adj := -0.06
            else if rate > tp_hit_target * 1.5
                adj := 0.08
            else if rate > tp_hit_target * 1.2
                adj := 0.04
            pct := math.max(tp_adj_min, math.min(tp_adj_max, tp_percentile + adj))
        array<float> vals = array.new<float>()
        array<float> wts = array.new<float>()
        for q = s0 to n_use - 1
            int j = array.get(use_i, q)
            float m = array.get(h.mfe, j)
            float mv = array.get(h.moved, j)
            if m == 0.0 and mv != 0.0
                m := math.abs(mv)
            m := math.max(m, 0.1)
            int et2 = array.get(h.etype, j)
            float w = et2 == 0 ? 1.0 : et2 == 2 ? 0.8 : et2 == 1 ? 0.6 : 0.4
            array.push(vals, m)
            array.push(wts, w)
        float tpp = f_wpctl(vals, wts, pct) * disc
        tpp := disc >= 1.0 ? tpp * tp_capture : tpp * (tp_capture + 1.0) / 2.0
        if atr_val > 0.0
            float cap = atr_val * 2.0 / entry * 100.0
            if tpp > cap
                tpp := cap
        tp_pct := math.max(min_tp_pct, math.min(max_tp_pct, tpp))
        fb := false
    [tp_pct, fb]

// signals.calculate_adaptive_sl() incl. calculate_sl() fallback: returns [sl, source]
f_adaptive_sl(Hist h, int side, float entry, float atr_val, float fl_v, float fu_v) =>
    float sl_fb = na
    if side == 1
        float sl_atr = entry - 1.5 * atr_val
        float s = na(fl_v) ? sl_atr : math.max(fl_v, sl_atr)
        sl_fb := math.min(s, entry * 0.995)
    else
        float sl_atr = entry + 1.5 * atr_val
        float s = na(fu_v) ? sl_atr : math.min(fu_v, sl_atr)
        sl_fb := math.max(s, entry * 1.005)
    float sl = sl_fb
    string src = "frama/atr"
    if sl_adaptive
        array<float> mae_f = array.new<float>()
        int n_h = array.size(h.etype)
        if n_h > 0
            for i = 0 to n_h - 1
                int et = array.get(h.etype, i)
                float m = array.get(h.mae, i)
                if (et == 0 or et == 3) and m > 0.0
                    array.push(mae_f, m / 100.0)
        int nw = array.size(mae_f)
        if nw >= sl_min_hist
            float p = array.percentile_linear_interpolation(mae_f, sl_mae_pct * 100.0)
            float mae_b = p + sl_mae_buf / 100.0
            float max_risk = sl_max_atr * atr_val / entry
            if mae_b > max_risk
                mae_b := max_risk
            if side == 1
                sl := math.min(entry * (1.0 - mae_b), entry * (1.0 - sl_min_dist / 100.0))
            else
                sl := math.max(entry * (1.0 + mae_b), entry * (1.0 + sl_min_dist / 100.0))
            src := "adaptive MAE"
        else
            src := "frama/atr (" + str.tostring(nw) + "/" + str.tostring(sl_min_hist) + ")"
    [sl, src]

// Records a closed trade (state.update_signal_record / signals.close_trade).
// etype: 0 tp, 1 sl, 2 sl_after_tp1, 3 cancelled
f_finish(Trade t, Hist h, float exit_px, int etype) =>
    float leg_full = t.side == 1 ? (exit_px - t.entry) / t.entry * 100.0 : (t.entry - exit_px) / t.entry * 100.0
    float pnl = leg_full
    if t.tp1_hit
        float leg1 = t.side == 1 ? (t.tp1 - t.entry) / t.entry * 100.0 : (t.entry - t.tp1) / t.entry * 100.0
        pnl := (leg1 + leg_full) / 2.0
    array.push(h.mfe, t.mfe)
    array.push(h.mae, t.mae)
    array.push(h.moved, pnl)
    array.push(h.etype, etype)
    array.push(h.regime, t.regime)
    if array.size(h.etype) > hist_cap
        array.shift(h.mfe)
        array.shift(h.mae)
        array.shift(h.moved)
        array.shift(h.etype)
        array.shift(h.regime)
    t.n += 1
    if pnl > 0.0
        t.wins += 1
    t.pnl_sum += pnl
    if t.side == 1
        t.last_exit_long := bar_index
    else
        t.last_exit_short := bar_index
    t.active := false
    t.ev_exit := etype + 1

// Diagnostics: where did candidate signals (raw + filters passed) go?
f_count(Trade t, bool was_act, bool cand_l, bool cand_s, bool cd_l, bool cd_s, bool op_l, bool op_s) =>
    if cand_l or cand_s
        t.c_cand += 1
        if was_act
            t.c_busy += 1
        else if not ((cand_l and cd_l) or (cand_s and cd_s))
            t.c_cd += 1
        else if op_l or op_s
            t.c_open += 1
        else
            t.c_rej += 1

// Per-bar management of an open trade — mirrors backtest_history()'s loop:
// SL before TP2 on one bar, same-bar TP1+SL policy, TP1 touch moves the SL (checked
// from the NEXT bar on), time stop at the close of bar `max_hold`.
f_manage(Trade t, Hist hl, Hist hs) =>
    t.ev_tp1 := false
    t.ev_exit := 0
    if t.active and bar_index > t.entry_bar
        Hist h = t.side == 1 ? hl : hs
        float fav = t.side == 1 ? (high - t.entry) / t.entry * 100.0 : (t.entry - low) / t.entry * 100.0
        float adv = t.side == 1 ? (t.entry - low) / t.entry * 100.0 : (high - t.entry) / t.entry * 100.0
        t.mfe := math.max(t.mfe, fav)
        t.mae := math.max(t.mae, adv)
        bool closed = false
        if t.side == 1
            if not t.tp1_hit
                if same_bar_tp1 == "tp1_first" and high >= t.tp1 and high < t.tp2 and low <= t.sl
                    t.tp1_hit := true
                    t.ev_tp1 := true
                    t.sl := t.entry + tp1_frac * (t.tp1 - t.entry)
                    f_finish(t, h, t.sl, 2)
                    closed := true
                else if low <= t.sl
                    f_finish(t, h, t.sl, 1)
                    closed := true
                else if high >= t.tp2
                    t.tp1_hit := true
                    f_finish(t, h, t.tp2, 0)
                    closed := true
                else if high >= t.tp1
                    t.tp1_hit := true
                    t.ev_tp1 := true
                    t.sl := t.entry + tp1_frac * (t.tp1 - t.entry)
            else
                if low <= t.sl
                    f_finish(t, h, t.sl, 2)
                    closed := true
                else if high >= t.tp2
                    f_finish(t, h, t.tp2, 0)
                    closed := true
        else
            if not t.tp1_hit
                if same_bar_tp1 == "tp1_first" and low <= t.tp1 and low > t.tp2 and high >= t.sl
                    t.tp1_hit := true
                    t.ev_tp1 := true
                    t.sl := t.entry + tp1_frac * (t.tp1 - t.entry)
                    f_finish(t, h, t.sl, 2)
                    closed := true
                else if high >= t.sl
                    f_finish(t, h, t.sl, 1)
                    closed := true
                else if low <= t.tp2
                    t.tp1_hit := true
                    f_finish(t, h, t.tp2, 0)
                    closed := true
                else if low <= t.tp1
                    t.tp1_hit := true
                    t.ev_tp1 := true
                    t.sl := t.entry + tp1_frac * (t.tp1 - t.entry)
            else
                if high >= t.sl
                    f_finish(t, h, t.sl, 2)
                    closed := true
                else if low <= t.tp2
                    f_finish(t, h, t.tp2, 0)
                    closed := true
        if not closed and bar_index - t.entry_bar >= max_hold
            f_finish(t, h, close, 3)

// signals.open_position(): SL -> TP1/TP2 -> R:R gate -> bar-extreme check. Opens at the
// signal bar close. Returns true when a trade was opened.
f_try_open(Trade t, Hist h, int side, float atr_val, float fl_v, float fu_v, int reg) =>
    bool ok = false
    float entry = close
    float sl = na
    float tp1 = na
    float tp2 = na
    string sl_src = "fixed"
    string tp_src = "fixed"
    if use_auto_params
        [sl_a, sl_d] = f_adaptive_sl(h, side, entry, atr_val, fl_v, fu_v)
        sl := sl_a
        sl_src := sl_d
        float risk = math.abs(entry - sl)
        [tp_pct, fb] = f_adaptive_tp(h, atr_val, entry, reg)
        if fb
            tp1 := entry + side * tp1_fb_rr * risk
            tp2 := entry + side * tp2_fb_rr * risk
            tp_src := "fallback R:R"
        else
            tp1 := entry * (1.0 + side * tp_pct / 100.0)
            float rr_tp = entry + side * min_rr * risk
            tp2 := side == 1 ? math.max(tp1, rr_tp) : math.min(tp1, rr_tp)
            tp_src := "adaptive " + str.tostring(tp_pct, "#.##") + "%"
        float md = sl_min_dist / 100.0
        if side == 1
            tp1 := math.min(math.max(tp1, entry * (1.0 + md)), tp2)
        else
            tp1 := math.max(math.min(tp1, entry * (1.0 - md)), tp2)
        float rr = math.abs(tp2 - entry) / math.max(risk, 1e-8)
        bool ext_bad = side == 1 ? low <= sl : high >= sl
        ok := rr >= min_rr and not ext_bad
    else
        sl := entry - side * sl_mult * atr_val
        tp2 := entry + side * tp_mult * atr_val
        tp1 := tp2
        bool ext_bad2 = side == 1 ? low <= sl : high >= sl
        ok := not ext_bad2
    if ok
        float sl_atr_m = math.max(1.0, math.min(3.5, math.abs(entry - sl) / math.max(atr_val, 1e-8)))
        int lv = math.max(1, math.min(max_allowed_lev, int(target_risk_depo / math.max(sl_atr_m, 0.1))))
        if enable_adaptive_lev and enable_ai_regime
            if reg == 2
                lv := math.max(1, int(lv * 0.5))
            else if reg == 1
                lv := math.min(max_allowed_lev, int(lv * 1.2))
        t.active := true
        t.side := side
        t.entry := entry
        t.sl := sl
        t.tp1 := tp1
        t.tp2 := tp2
        t.tp1_hit := false
        t.entry_bar := bar_index
        t.atr_at := atr_val
        t.mfe := 0.0
        t.mae := 0.0
        t.regime := reg
        t.lev := lv
        t.sl_src := sl_src
        t.tp_src := tp_src
    ok

// ═════════════════════════════════════════════════════════════════════════════
// 3. S&R POWER CHANNEL
// ═════════════════════════════════════════════════════════════════════════════
type data
	line sup = na
	line res = na
	box sup_area = na
	box res_area = na

// --------------------------------------------------------------------------------------------------------------------}
// INDICATOR CALCULATIONS
// --------------------------------------------------------------------------------------------------------------------{

max_min(length, d) =>
    var max = array.new<float>(length)
    var min = array.new<float>(length)

    if barstate.islast
        for i = 0 to length - 1 by 1
            max.set(i, high[i])
            min.set(i, low[i])


        float max_ = max.max()
        float min_ = min.min()
        float mid_ = math.avg(max_, min_)

        label.delete(label.new(bar_index + sr_extend + 15, max_, str.tostring(max_, '🡅 #.##'), color = color(na), style = label.style_label_center, textcolor = chart.fg_color)[1])
        label.delete(label.new(bar_index + sr_extend + 15, min_, str.tostring(min_, '🡇 #.##'), color = color(na), style = label.style_label_center, textcolor = chart.fg_color)[1])
        label.delete(label.new(bar_index + sr_extend, mid_, str.tostring(mid_, '🡆 #.##'), color = color(na), style = label.style_label_left, textcolor = color.gray)[1])
        line.delete(line.new(bar_index - sr_length, mid_, bar_index + sr_extend, mid_, color = color.gray, style = line.style_dotted)[1])

        index_of_max = max.indexof(max_)
        index_of_min = min.indexof(min_)

        label.delete(label.new(bar_index[index_of_max], max_, '✖', color = color(na), textcolor = color.new(sr_top_col,0), size = size.normal, style = label.style_label_center)[1])
        label.delete(label.new(bar_index[index_of_min], min_, '✖', color = color(na), textcolor = color.new(sr_bot_col,0), size = size.normal, style = label.style_label_center)[1])
    [max.max(), min.min()]


delte_(data d) =>
    field_0 = d.sup
    line.delete(field_0[1])
    field_1 = d.res
    line.delete(field_1[1])
    field_2 = d.sup_area
    box.delete(field_2[1])
    field_3 = d.res_area
    box.delete(field_3[1])

power(d) =>
    int buy = 0
    int sell = 0

    if barstate.islast
        for i = 0 to sr_length - 1 by 1
            buy := buy + (close[i] > open[i] ? 1 : 0)
            sell := sell + (close[i] < open[i] ? 1 : 0)

    d.sup_area.set_text(str.tostring(buy, '            Buy Power: #'))
    d.res_area.set_text(str.tostring(sell, '            Sell Power: #'))

    d.res_area.set_text_color(chart.fg_color)
    d.sup_area.set_text_color(chart.fg_color)
    d.res_area.set_text_halign(text.align_left)
    d.sup_area.set_text_halign(text.align_left)
    d.res_area.set_text_size(size.normal)
    d.sup_area.set_text_size(size.normal)


signals(d) =>
    if barstate.islast
        for i = 0 to sr_length - 1 by 1

            low_1 = low[i]
            low_2 = low[i > 0 ? i + 1 : i]

            high_1 = high[i]
            high_2 = high[i > 0 ? i + 1 : i]

            index = bar_index - i
            top = d.sup_area.get_top()
            bot = d.res_area.get_bottom()

            if low_1 > top and low_2 <= top
                label.new(index, low_2, '◈',textcolor = color.new(sr_bot_col, 0), color = color(na), style = label.style_label_up, size = size.large)

            if high_1 < bot and high_2 >= bot
                label.new(index, high_2, '◈', textcolor = color.new(sr_top_col,0), color = color(na), style = label.style_label_down, size = size.large)

run_indicator() =>
    float atr = ta.atr(200) * 0.5
    var data d = data.new(line(na), line(na), box(na), box(na))

    [max, min] = max_min(sr_length, d)
    if barstate.islast
        d.sup := line.new(bar_index - sr_length, max + atr, bar_index + sr_extend + 30, max + atr, color = sr_top_col, style = line.style_solid)
        d.res := line.new(bar_index - sr_length, min - atr, bar_index + sr_extend + 30, min - atr, color = sr_bot_col, style = line.style_solid)

        d.res_area := box.new(bar_index - sr_length, max + atr, bar_index + sr_extend, max - atr, na, bgcolor = color.new(sr_top_col, 80))
        d.sup_area := box.new(bar_index - sr_length, min + atr, bar_index + sr_extend, min - atr, na, bgcolor = color.new(sr_bot_col, 80))

    delte_(d)
    signals(d)
    power(d)


// --------------------------------------------------------------------------------------------------------------------}
// VISUALIZATION
// --------------------------------------------------------------------------------------------------------------------{
if show_sr
    run_indicator()

// ═════════════════════════════════════════════════════════════════════════════
// 4. ANDEAN + MFI (K-Means levels retrained on every closed bar)
// ═════════════════════════════════════════════════════════════════════════════
osc_mfi = ta.mfi(hlc3, mfi_len)

// Rolling buffer of the last `mfi_training` closed-bar MFI values (indicators.run_kmeans_mfi
// takes mfi.dropna().tail(training) up to and including the signal bar).
var array<float> mfi_hist = array.new<float>()
var float level_os = na
var float level_ob = na
if barstate.isconfirmed and not na(osc_mfi)
    array.push(mfi_hist, osc_mfi)
    if array.size(mfi_hist) > mfi_training
        array.shift(mfi_hist)
    if bar_index % kmeans_every == 0
        [c_lo, c_hi] = f_kmeans(mfi_hist)
        level_os := c_lo
        level_ob := c_hi

alpha = 2.0 / (and_len + 1)
var float upper_ema1 = na
var float upper_ema2 = na
var float lower_ema1 = na
var float lower_ema2 = na

upper_ema1 := nz(math.max(close, open, upper_ema1 - (upper_ema1 - close) * alpha), close)
upper_ema2 := nz(math.max(close * close, open * open, upper_ema2 - (upper_ema2 - close * close) * alpha), close * close)
lower_ema1 := nz(math.min(close, open, lower_ema1 + (close - lower_ema1) * alpha), close)
lower_ema2 := nz(math.min(close * close, open * open, lower_ema2 + (close * close - lower_ema2) * alpha), close * close)

and_osc = math.sqrt(math.max(0, lower_ema2 - lower_ema1 * lower_ema1)) -
          math.sqrt(math.max(0, upper_ema2 - upper_ema1 * upper_ema1))
and_sig = ta.ema(and_osc, and_sig_len)

// ═════════════════════════════════════════════════════════════════════════════
// 5. UT BOT (crossover fixed on bar close)
// ═════════════════════════════════════════════════════════════════════════════
ut_src = close
if ut_h
    ha_ticker = ticker.heikinashi(syminfo.tickerid)
    ut_src := request.security(ha_ticker, timeframe.period, close,
              gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)

ut_xATR  = ta.atr(ut_c)
ut_nLoss = ut_a * ut_xATR

var float xATRTrailingStop = 0.0
float prev_stop = nz(xATRTrailingStop[1])
xATRTrailingStop := ut_src > prev_stop and ut_src[1] > prev_stop ? math.max(prev_stop, ut_src - ut_nLoss) :
                     ut_src < prev_stop and ut_src[1] < prev_stop ? math.min(prev_stop, ut_src + ut_nLoss) :
                     ut_src > prev_stop ? ut_src - ut_nLoss : ut_src + ut_nLoss

bool ut_x_up = ta.crossover(ut_src, xATRTrailingStop)
bool ut_x_dn = ta.crossunder(ut_src, xATRTrailingStop)
bool ut_buy_raw  = barstate.isconfirmed and ut_src > xATRTrailingStop and ut_x_up
bool ut_sell_raw = barstate.isconfirmed and ut_src < xATRTrailingStop and ut_x_dn

// ═════════════════════════════════════════════════════════════════════════════
// 6. FRAMA CHANNEL + FILTERS
// ═════════════════════════════════════════════════════════════════════════════
int n = frama_len / 2
float hh1 = ta.highest(high, n)
float ll1 = ta.lowest(low, n)
float n1  = (hh1 - ll1) / n
float hh2 = ta.highest(high, n)[n]
float ll2 = ta.lowest(low, n)[n]
float n2  = (hh2 - ll2) / n
float hh3 = ta.highest(high, frama_len)
float ll3 = ta.lowest(low, frama_len)
float n3  = (hh3 - ll3) / frama_len

float dimen = 0.0
if n1 > 0 and n2 > 0 and n3 > 0
    dimen := (math.log(n1 + n2) - math.log(n3)) / math.log(2.0)

float alpha_frama = math.max(0.01, math.min(1.0, math.exp(-4.6 * (dimen - 1.0))))

var float frama_ma = na
frama_ma := na(frama_ma) ? close : alpha_frama * close + (1.0 - alpha_frama) * nz(frama_ma[1])

float safe_atr14_raw = ta.atr(14)
float atr14   = nz(safe_atr14_raw, close * 0.01)
float trade_atr = ta.atr(atr_period)
float atr_pct = nz(trade_atr, close * 0.01) / close * 100
bool  atr_ok  = use_atr_f ? (atr_pct >= atr_min and atr_pct <= atr_max) : true

float frama_atr   = nz(ta.atr(frama_len), close * 0.01)
float frama_upper = frama_ma + frama_atr * frama_mult
float frama_lower = frama_ma - frama_atr * frama_mult

var int frama_dir = 0
if close > frama_upper
    frama_dir := 1
else if close < frama_lower
    frama_dir := -1

bool frama_bullish = frama_dir == 1
bool frama_bearish = frama_dir == -1

plot(show_frama ? frama_ma : na, "FRAMA Mid",
     color = frama_bullish ? f_up_col : frama_bearish ? f_dn_col : color.gray,
     linewidth = 2, display = display.all - display.price_scale - display.status_line)
p_f_upper = plot(show_frama ? frama_upper : na, "FRAMA Upper", color = color.new(f_up_col, 40),
                 display = display.all - display.price_scale - display.status_line)
p_f_lower = plot(show_frama ? frama_lower : na, "FRAMA Lower", color = color.new(f_dn_col, 40),
                 display = display.all - display.price_scale - display.status_line)
fill(p_f_upper, p_f_lower,
     color = frama_bullish ? color.new(f_up_col, 95) : frama_bearish ? color.new(f_dn_col, 95) : color.new(color.gray, 95),
     title = "FRAMA Channel BG")

ci = 100 * math.log10(math.sum(ta.atr(1), chop_length) /
     math.max(ta.highest(chop_length) - ta.lowest(chop_length), 0.000001)) / math.log10(chop_length)
chop_trend = ci < chop_threshold
bgcolor(show_chop_bg and not chop_trend ? color.new(color.orange, 90) : na, title = "CHOP Sideways BG")

frama_slope = frama_ma - nz(frama_ma[1])

frama_ok_long  = use_frama_filter ? frama_bullish : true
frama_ok_short = use_frama_filter ? frama_bearish : true
chop_ok        = use_chop ? chop_trend : true

// HURST — recomputed only on closed bars (O(window)); last closed value reused on ticks
var float hurst_val = na
if use_hurst and barstate.isconfirmed
    hurst_val := f_hurst(hurst_window, hurst_bias)
hurst_pass_trend     = not na(hurst_val) and (hurst_val - 0.5) >= hurst_min_dev
hurst_pass_symmetric = not na(hurst_val) and math.abs(hurst_val - 0.5) >= hurst_min_dev
hurst_ok = use_hurst ? (hurst_mode == "Trending Only" ? hurst_pass_trend : hurst_pass_symmetric) : true

var label hurst_dbg_lbl = na
if show_hurst_label and barstate.islast
    label.delete(hurst_dbg_lbl[1])
    string hurst_txt = na(hurst_val) ? "Hurst: n/a" : "Hurst: " + str.tostring(hurst_val, "#.###") + (hurst_val > 0.5 + hurst_min_dev ? " (trending)" : hurst_val < 0.5 - hurst_min_dev ? " (mean-rev)" : " (random-walk, blocked)")
    hurst_dbg_lbl := label.new(bar_index, high + atr14 * 2, hurst_txt,
         style = label.style_label_down, color = color.new(color.blue, 20), textcolor = color.white, size = size.small)

// ═════════════════════════════════════════════════════════════════════════════
// 7. HTF BIAS (last CLOSED higher-timeframe candle, like get_htf_bias())
// ═════════════════════════════════════════════════════════════════════════════
[htf_close_prev, htf_frama_prev] = request.security(syminfo.tickerid, htf, [close[1], frama_ma[1]],
     gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
htf_bull = htf_close_prev > htf_frama_prev
htf_bear = htf_close_prev < htf_frama_prev

// ═════════════════════════════════════════════════════════════════════════════
// 8. REGIME, EXTREME FILTERS
// ═════════════════════════════════════════════════════════════════════════════
atr_regime = atr_pct > atr_max ? "CHAOS" : atr_pct > (atr_min * 1.5) ? "TREND" : "NORMAL"
int reg_code = atr_pct > atr_max ? 2 : atr_pct > (atr_min * 1.5) ? 1 : 0

float hh10_prev = ta.highest(high, 10)[1]
float ll10_prev = ta.lowest(low, 10)[1]
float hh5_prev  = ta.highest(high, 5)[1]
float ll5_prev  = ta.lowest(low, 5)[1]
fake_break_long  = high > hh10_prev and close < hh10_prev
fake_break_short = low < ll10_prev and close > ll10_prev
liq_sweep_long   = low < ll5_prev and close > ll5_prev and close > open
liq_sweep_short  = high > hh5_prev and close < hh5_prev and close < open

filter_long = frama_ok_long and chop_ok and atr_ok and hurst_ok and frama_slope > 0 and
     (not enable_mtf_bias or htf_bull) and
     (not enable_fake_break or not fake_break_long) and
     (not enable_liq_sweep or not liq_sweep_short)
filter_short = frama_ok_short and chop_ok and atr_ok and hurst_ok and frama_slope < 0 and
     (not enable_mtf_bias or htf_bear) and
     (not enable_fake_break or not fake_break_short) and
     (not enable_liq_sweep or not liq_sweep_long)

// ═════════════════════════════════════════════════════════════════════════════
// 9. A-TRACK CONFIRMATION (MFI level crossover + Andean crossover within the window)
// ═════════════════════════════════════════════════════════════════════════════
bool levels_ready = not na(level_os) and not na(level_ob)
bool warmed_up    = array.size(mfi_hist) >= mfi_training

// MFI crossovers against the CURRENT K-Means level, for the signal bar and the lookback window
bool mfi_up_now = levels_ready and osc_mfi > level_os and osc_mfi[1] <= level_os
bool mfi_dn_now = levels_ready and osc_mfi < level_ob and osc_mfi[1] >= level_ob
int  bs_mfi_bull = f_bars_since_lvl(osc_mfi, level_os, lookback, true)
int  bs_mfi_bear = f_bars_since_lvl(osc_mfi, level_ob, lookback, false)

bool and_x_up = ta.crossover(and_osc, and_sig)
bool and_x_dn = ta.crossunder(and_osc, and_sig)
int  bs_and_bull = nz(ta.barssince(and_x_up), 999)
int  bs_and_bear = nz(ta.barssince(and_x_dn), 999)

confirm_long_a  = (mfi_up_now and bs_and_bull <= lookback) or (and_x_up and bs_mfi_bull <= lookback)
confirm_short_a = (mfi_dn_now and bs_and_bear <= lookback) or (and_x_dn and bs_mfi_bear <= lookback)

// ═════════════════════════════════════════════════════════════════════════════
// 10. TRADE ENGINE RUN (closed bars only: manage exits first, then new signals)
// ═════════════════════════════════════════════════════════════════════════════
var Hist h_a_l = Hist.new(array.new<float>(), array.new<float>(), array.new<float>(), array.new<int>(), array.new<int>())
var Hist h_a_s = Hist.new(array.new<float>(), array.new<float>(), array.new<float>(), array.new<int>(), array.new<int>())
var Hist h_u_l = Hist.new(array.new<float>(), array.new<float>(), array.new<float>(), array.new<int>(), array.new<int>())
var Hist h_u_s = Hist.new(array.new<float>(), array.new<float>(), array.new<float>(), array.new<int>(), array.new<int>())
var Trade a_tr = Trade.new()
var Trade u_tr = Trade.new()

bool a_open_l = false
bool a_open_s = false
bool u_open_l = false
bool u_open_s = false
bool ev_tp1_any  = false
bool ev_tp_any   = false
bool ev_sl_any   = false
bool ev_part_any = false
bool ev_time_any = false

if barstate.isconfirmed
    f_manage(a_tr, h_a_l, h_a_s)
    f_manage(u_tr, h_u_l, h_u_s)
    ev_tp1_any  := a_tr.ev_tp1 or u_tr.ev_tp1
    ev_tp_any   := a_tr.ev_exit == 1 or u_tr.ev_exit == 1
    ev_sl_any   := a_tr.ev_exit == 2 or u_tr.ev_exit == 2
    ev_part_any := a_tr.ev_exit == 3 or u_tr.ev_exit == 3
    ev_time_any := a_tr.ev_exit == 4 or u_tr.ev_exit == 4

    // cooldown is armed on EXIT, per track and side
    bool a_cd_l = na(a_tr.last_exit_long)  or bar_index - a_tr.last_exit_long  >= cooldown_bars
    bool a_cd_s = na(a_tr.last_exit_short) or bar_index - a_tr.last_exit_short >= cooldown_bars
    bool u_cd_l = na(u_tr.last_exit_long)  or bar_index - u_tr.last_exit_long  >= cooldown_bars
    bool u_cd_s = na(u_tr.last_exit_short) or bar_index - u_tr.last_exit_short >= cooldown_bars

    bool sig_a_l = enable_a and confirm_long_a  and filter_long  and warmed_up and not a_tr.active and a_cd_l
    bool sig_a_s = enable_a and confirm_short_a and filter_short and warmed_up and not a_tr.active and a_cd_s
    bool sig_u_l = enable_u and ut_buy_raw  and filter_long  and not u_tr.active and u_cd_l
    bool sig_u_s = enable_u and ut_sell_raw and filter_short and not u_tr.active and u_cd_s

    bool a_was = a_tr.active
    bool u_was = u_tr.active
    if sig_a_l
        a_open_l := f_try_open(a_tr, h_a_l, 1, atr14, frama_lower, frama_upper, reg_code)
    if sig_a_s and not a_tr.active
        a_open_s := f_try_open(a_tr, h_a_s, -1, atr14, frama_lower, frama_upper, reg_code)
    if sig_u_l
        u_open_l := f_try_open(u_tr, h_u_l, 1, atr14, frama_lower, frama_upper, reg_code)
    if sig_u_s and not u_tr.active
        u_open_s := f_try_open(u_tr, h_u_s, -1, atr14, frama_lower, frama_upper, reg_code)
    f_count(a_tr, a_was, enable_a and confirm_long_a and filter_long and warmed_up, enable_a and confirm_short_a and filter_short and warmed_up, a_cd_l, a_cd_s, a_open_l, a_open_s)
    f_count(u_tr, u_was, enable_u and ut_buy_raw and filter_long, enable_u and ut_sell_raw and filter_short, u_cd_l, u_cd_s, u_open_l, u_open_s)

bool any_open_l = a_open_l or u_open_l
bool any_open_s = a_open_s or u_open_s

// ═════════════════════════════════════════════════════════════════════════════
// 11. CONFIDENCE, REVERSAL WARNING, POSITION STATUS
// ═════════════════════════════════════════════════════════════════════════════
// Same components as calc_confidence() minus on-chain / relative strength / volume profile
float conf_long  = (chop_trend ? 20 : 0) + (atr_ok ? 20 : 0) + (frama_bullish ? 15 : 0) +
     ((a_open_l and u_open_l) ? 25 : (a_open_l or u_open_l) ? 10 : 0) + (htf_bull ? 20 : 0)
float conf_short = (chop_trend ? 20 : 0) + (atr_ok ? 20 : 0) + (frama_bearish ? 15 : 0) +
     ((a_open_s and u_open_s) ? 25 : (a_open_s or u_open_s) ? 10 : 0) + (htf_bear ? 20 : 0)
conf_long  := math.min(conf_long, 100)
conf_short := math.min(conf_short, 100)

bool in_long_any  = (a_tr.active and a_tr.side == 1) or (u_tr.active and u_tr.side == 1)
bool in_short_any = (a_tr.active and a_tr.side == -1) or (u_tr.active and u_tr.side == -1)
bool any_in_pos   = in_long_any or in_short_any

float ai_confidence = any_open_l ? conf_long : any_open_s ? conf_short :
     in_long_any ? conf_long : in_short_any ? conf_short : (conf_long + conf_short) / 2

bool and_rev_vs_long  = in_long_any  and and_x_dn and barstate.isconfirmed
bool and_rev_vs_short = in_short_any and and_x_up and barstate.isconfirmed
bool reversal_warn    = and_rev_vs_long or and_rev_vs_short

float rev_pnl_atr = a_tr.active ? a_tr.side * (close - a_tr.entry) / a_tr.atr_at :
     u_tr.active ? u_tr.side * (close - u_tr.entry) / u_tr.atr_at : 0.0

string rev_text  = ""
color  rev_color = color.gray
if reversal_warn and any_in_pos
    if rev_pnl_atr >= 0.3
        rev_text  := "Consider Exit"
        rev_color := color.orange
    else if rev_pnl_atr > -0.2
        rev_text  := "Move to BE"
        rev_color := color.yellow
    else
        rev_text  := "High Risk"
        rev_color := color.red

bool any_tp1_state = (a_tr.active and a_tr.tp1_hit) or (u_tr.active and u_tr.tp1_hit)

// ═════════════════════════════════════════════════════════════════════════════
// 12. VISUALS
// ═════════════════════════════════════════════════════════════════════════════
plotshape(a_open_l, title = "A BUY",  text = "A Buy",  style = shape.labelup,
          location = location.belowbar, color = a_buy_col,  textcolor = color.white, size = size.small)
plotshape(a_open_s, title = "A SELL", text = "A Sell", style = shape.labeldown,
          location = location.abovebar, color = a_sell_col, textcolor = color.white, size = size.small)
plotshape(u_open_l, title = "U BUY",  text = "U Buy",  style = shape.labelup,
          location = location.belowbar, color = u_buy_col,  textcolor = color.white, size = size.small)
plotshape(u_open_s, title = "U SELL", text = "U Sell", style = shape.labeldown,
          location = location.abovebar, color = u_sell_col, textcolor = color.white, size = size.small)

// Exit / TP1 markers
plotshape(show_exits and ev_tp1_any,  title = "TP1 hit",       style = shape.circle,   location = location.abovebar, color = color.yellow, size = size.tiny)
plotshape(show_exits and ev_tp_any,   title = "TP2 exit",      style = shape.diamond,  location = location.abovebar, color = color.lime,   size = size.tiny)
plotshape(show_exits and ev_part_any, title = "sl_after_tp1",  style = shape.diamond,  location = location.belowbar, color = color.yellow, size = size.tiny)
plotshape(show_exits and ev_sl_any,   title = "SL exit",       style = shape.xcross,   location = location.belowbar, color = color.red,    size = size.tiny)
plotshape(show_exits and ev_time_any, title = "Time stop",     style = shape.square,   location = location.belowbar, color = color.gray,   size = size.tiny)

// TP2 / TP1 / SL of the open trade of each track
plot(show_sl_tp and a_tr.active ? a_tr.tp2 : na, "A TP2", color = a_tp_col, style = plot.style_cross, linewidth = 2)
plot(show_sl_tp and a_tr.active ? a_tr.tp1 : na, "A TP1", color = color.new(a_tp_col, 40), style = plot.style_circles, linewidth = 1)
plot(show_sl_tp and a_tr.active ? a_tr.sl  : na, "A SL",  color = sl_col, style = plot.style_cross, linewidth = 1)
plot(show_sl_tp and u_tr.active ? u_tr.tp2 : na, "U TP2", color = u_tp_col, style = plot.style_cross, linewidth = 2)
plot(show_sl_tp and u_tr.active ? u_tr.tp1 : na, "U TP1", color = color.new(u_tp_col, 40), style = plot.style_circles, linewidth = 1)
plot(show_sl_tp and u_tr.active ? u_tr.sl  : na, "U SL",  color = sl_col, style = plot.style_cross, linewidth = 1)

// Bar color
barbuy  = use_frama_filter ? frama_bullish : (ut_src > xATRTrailingStop)
barsell = use_frama_filter ? frama_bearish : (ut_src < xATRTrailingStop)
barcolor(barbuy ? color.new(color.green, 50) : barsell ? color.new(color.red, 50) : na)

// Bollinger Bands
basis = ma(bb_src, bb_len, bb_maType)
dev   = bb_mult * ta.stdev(bb_src, bb_len)
upper = basis + dev
lower = basis - dev
plot(show_bb ? basis : na, "BB Basis", color = bb_basis_col, offset = bb_offset)
bb_p1 = plot(show_bb ? upper : na, "BB Upper", color = bb_upper_col, offset = bb_offset)
bb_p2 = plot(show_bb ? lower : na, "BB Lower", color = bb_lower_col, offset = bb_offset)
fill(bb_p1, bb_p2, title = "BB Background", color = bb_fill_col)

// ═════════════════════════════════════════════════════════════════════════════
// 13. TABLE (compact)
// ═════════════════════════════════════════════════════════════════════════════
f_cell(table tb, int col, int row, string txt, color c) =>
    table.cell(tb, col, row, txt, text_color = c, text_size = size.small)

f_pos_txt(Trade t) =>
    t.active ? (t.side == 1 ? "LONG" : "SHORT") + (t.tp1_hit ? " +TP1" : "") : "—"

f_px_txt(Trade t, float v) =>
    t.active ? str.tostring(v, format.mintick) : "—"

f_track_col(table tb, int col, Trade t, color c) =>
    f_cell(tb, col, 1, f_pos_txt(t), t.active ? (t.side == 1 ? color.lime : color.red) : color.gray)
    f_cell(tb, col, 2, f_px_txt(t, t.sl), color.orange)
    f_cell(tb, col, 3, f_px_txt(t, t.tp1), color.silver)
    f_cell(tb, col, 4, f_px_txt(t, t.tp2), c)
    f_cell(tb, col, 5, t.active ? "x" + str.tostring(t.lev) : "—", color.yellow)
    f_cell(tb, col, 6, str.tostring(t.wins) + " / " + str.tostring(t.n), color.white)
    float wr = t.n > 0 ? 100.0 * t.wins / t.n : na
    f_cell(tb, col, 7, na(wr) ? "—" : str.tostring(wr, "#.#") + "%", na(wr) ? color.gray : wr >= 50 ? color.lime : color.orange)
    float ap = t.n > 0 ? t.pnl_sum / t.n : na
    f_cell(tb, col, 8, na(ap) ? "—" : str.tostring(ap, "#.##") + "%", na(ap) ? color.gray : ap >= 0 ? color.lime : color.red)

var table tbl = na

if show_table and barstate.islast
    if na(tbl)
        tbl := table.new(tbl_pos, 3, 16,
              bgcolor = color.new(color.black, 70),
              border_width = 1, border_color = color.gray,
              frame_color = color.gray, frame_width = 1)
        // rows 12..15 (Regime, AI Conf, Status, SL/TP src): value spans the two track columns
        for r = 12 to 15
            table.merge_cells(tbl, 1, r, 2, r)

    f_cell(tbl, 0, 0, "MUFCA v5", #1b02fa)
    f_cell(tbl, 1, 0, "A" + (enable_a ? "" : " off"), color.teal)
    f_cell(tbl, 2, 0, "U" + (enable_u ? "" : " off"), color.green)
    f_cell(tbl, 0, 1, "Position", color.white)
    f_cell(tbl, 0, 2, "SL", color.white)
    f_cell(tbl, 0, 3, "TP1", color.white)
    f_cell(tbl, 0, 4, "TP2", color.white)
    f_cell(tbl, 0, 5, "Lev", color.white)
    f_cell(tbl, 0, 6, "Wins / Trades", color.white)
    f_cell(tbl, 0, 7, "Win rate", color.white)
    f_cell(tbl, 0, 8, "Avg PnL", color.white)
    f_track_col(tbl, 1, a_tr, color.teal)
    f_track_col(tbl, 2, u_tr, color.lime)

    f_cell(tbl, 0, 9, "MARKET", #1b02fa)
    f_cell(tbl, 1, 9, "", color.white)
    f_cell(tbl, 2, 9, "", color.white)

    // FRAMA trend | HTF bias
    f_cell(tbl, 0, 10, "FRAMA / HTF:", color.white)
    f_cell(tbl, 1, 10, frama_bullish ? "BULL" : frama_bearish ? "BEAR" : "RANGE",
         frama_bullish ? color.lime : frama_bearish ? color.red : color.yellow)
    f_cell(tbl, 2, 10, htf_bull ? "BULL" : htf_bear ? "BEAR" : "—",
         htf_bull ? color.lime : htf_bear ? color.red : color.gray)

    // CHOP | Hurst
    f_cell(tbl, 0, 11, "CHOP / Hurst:", color.white)
    f_cell(tbl, 1, 11, str.tostring(ci, "#.#") + (chop_trend ? " TREND" : " SIDE"),
         chop_trend ? color.lime : color.orange)
    f_cell(tbl, 2, 11, not use_hurst ? "OFF" : na(hurst_val) ? "warming up" : str.tostring(hurst_val, "#.###"),
         not use_hurst ? color.gray : na(hurst_val) ? color.gray : hurst_ok ? color.lime : color.red)

    f_cell(tbl, 0, 12, "Regime:", color.white)
    f_cell(tbl, 1, 12, atr_regime, atr_regime == "CHAOS" ? color.red : atr_regime == "TREND" ? color.lime : color.gray)

    f_cell(tbl, 0, 13, "AI Conf:", color.white)
    f_cell(tbl, 1, 13, str.tostring(ai_confidence, "#") + "%",
         ai_confidence >= 80 ? color.lime : ai_confidence >= 60 ? color.orange : color.red)

    string pos_status = "—"
    color  pos_color  = color.gray
    if any_in_pos
        if reversal_warn and rev_text != ""
            pos_status := rev_text
            pos_color  := rev_color
        else if any_tp1_state
            pos_status := "TP1 hit, SL moved"
            pos_color  := color.yellow
        else
            pos_status := "PnL: " + (rev_pnl_atr >= 0 ? "+" : "") + str.tostring(rev_pnl_atr, "#.##") + " ATR"
            pos_color  := rev_pnl_atr >= 0 ? color.lime : color.red
    f_cell(tbl, 0, 14, "Status:", color.white)
    table.cell(tbl, 1, 14, pos_status, text_color = pos_color, text_size = size.small,
         bgcolor = reversal_warn and any_in_pos ? color.new(color.orange, 80) : any_tp1_state ? color.new(color.yellow, 85) : color.new(color.black, 100))
    f_cell(tbl, 0, 15, "SL / TP src:", color.white)
    f_cell(tbl, 1, 15, a_tr.active ? a_tr.sl_src : u_tr.active ? u_tr.sl_src : "—", color.gray)

else if not show_table and not na(tbl)
    table.delete(tbl)
    tbl := na

// ═════════════════════════════════════════════════════════════════════════════
// 14. ALERTS
// ═════════════════════════════════════════════════════════════════════════════
alertcondition(u_open_l, "U BUY",  "U BUY @ {{close}} | UT Bot — entry at signal-bar close")
alertcondition(u_open_s, "U SELL", "U SELL @ {{close}} | UT Bot — entry at signal-bar close")
alertcondition(a_open_l, "A BUY",  "A BUY @ {{close}} | Andean+MFI — entry at signal-bar close")
alertcondition(a_open_s, "A SELL", "A SELL @ {{close}} | Andean+MFI — entry at signal-bar close")
alertcondition(a_open_l and u_open_l, "A+U BUY",  "A+U BUY @ {{close}} | Both tracks aligned LONG")
alertcondition(a_open_s and u_open_s, "A+U SELL", "A+U SELL @ {{close}} | Both tracks aligned SHORT")
alertcondition(ev_tp1_any, "TP1 Hit", "TP1 touched @ {{close}} — SL moved per TP1 mode")
alertcondition(ev_tp_any or ev_sl_any or ev_part_any or ev_time_any, "Position Closed", "Position closed @ {{close}}")
alertcondition(and_rev_vs_long,  "Long Reversal",  "Reversal vs LONG @ {{close}} — consider exit")
alertcondition(and_rev_vs_short, "Short Reversal", "Reversal vs SHORT @ {{close}} — consider exit")
