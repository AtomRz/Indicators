//@version=6

indicator("MUFCA [AtomDC] v6 - Elite", overlay = true, max_labels_count = 500, max_bars_back = 500, max_lines_count = 500, max_boxes_count = 500)

// ═════════════════════════════════════════════════════════════════════════════
// v6.0 — aligned with the current mufca-bot (signals.py / state.py / indicators.py /
//        volume_gate.py / shock_guard.py / volume_indicators.py / market_structure.py)
//   NEW vs v5:
//   + Trade history is now written at ENTRY (record "open") and filled in at exit, and is
//     SHARED per side by tracks A and U (cap 3 x history window) — like signals_history.json
//   + TP hit-rate loop: metric "tp1" (reached TP1) + self-calibrating target (hit rate before
//     the recent window, needs 15+ older exits) — bot defaults TP_HIT_RATE_METRIC / _TARGET_AUTO
//   + TP obstacle cap: TP2 is cut at the nearest significant S/R pivot cluster (>= 2 touches)
//     or Volume Profile POC / VAH / VAL (300 bars, 50 bins, VA 70%) when R:R still >= min R:R;
//     TP1 is rebuilt proportionally
//   + Volume-flow leverage adjustment (OBV / OBV momentum / volume pressure / relative volume)
//   + Low-volume entry gate (metrics bar / smooth / thin / how) — off by default, like the bot
//   + Market shock guard (4 bars, 5 x ATR) — warns, optional entry block
//   + Volume Profile histogram (POC / VAH / VAL, same 300 bars / 50 bins / 70% VA as the TP cap)
//   + Entry switches per track/side: allow / block_trend / block_all
//   + Defaults refreshed from config.py: FRAMA 22 / 2.1, Hurst windows 221 (1h) / 140 (4h), Hurst min dev 0.12
//   Carried over from v5: adaptive SL (MAE) + adaptive TP1/TP2 (weighted MFE percentile), regime
//   discount, capture rate, 2 x ATR cap, R:R gate, same-bar TP1 policy, SL move after TP1,
//   20-bar time stop, cooldown armed on exit, CHOP per timeframe, K-Means MFI, HTF bias.
//   Not ported (needs data the indicator does not have): on-chain / derivatives bias, spread
//   gate, AI verdict, shadow records, demand/supply zones, SMC overlay, relative strength,
//   1m intrabar TP1/SL check, seeded backtest history (the history starts empty on the chart).
// ═════════════════════════════════════════════════════════════════════════════

// ═════════════════════════════════════════════════════════════════════════════
// 1. INPUTS
// ═════════════════════════════════════════════════════════════════════════════
sig_grp = "SIGNAL SOURCES"
enable_a = input.bool(true, "Enable A Signals (Andean + MFI)",
     tooltip = "Type A signals — Andean oscillator combined with MFI K-Means levels. Less frequent, more precise.",
     group = sig_grp)
enable_u = input.bool(true, "Enable U Signals (UT Bot)",
     tooltip = "Type U signals — ATR trailing stop UT Bot. More frequent, reacts faster to reversals.",
     group = sig_grp)

filter_grp = "FILTER MODE"
use_frama_filter = input.bool(true, "Use FRAMA Filter",
     tooltip = "Allows A/U entries only in the direction of the FRAMA trend.",
     group = filter_grp)
use_chop = input.bool(true, "Use CHOP Filter",
     tooltip = "Blocks A/U signals during sideways markets (CHOP above the per-timeframe threshold, see CHOP FILTER group).",
     group = filter_grp)
use_atr_f = input.bool(true, "Use ATR Filter",
     tooltip = "Filters out markets that are too quiet or too chaotic. Applies to A and U.",
     group = filter_grp)
atr_period = input.int(14, "ATR Period",
     tooltip = "ATR period for the volatility filter (bot: 14).",
     group = filter_grp)
atr_min = input.float(0.3, "Min ATR %",
     tooltip = "Minimum volatility as a % of price (bot: 0.3).",
     group = filter_grp)
atr_max = input.float(4.5, "Max ATR %",
     tooltip = "Maximum volatility as a % of price (bot: 4.5). Above it the regime is CHAOS.",
     group = filter_grp)
use_hurst = input.bool(false, "Use Hurst Filter",
     tooltip = "Blocks signals when the market is close to a random walk, using a rolling R/S Hurst exponent of log-returns. Off by default, like in the bot. Computed once per closed bar.",
     group = filter_grp)
hurst_window_1h = input.int(221, "Hurst Window (1h chart)", minval = 18, maxval = 300,
     tooltip = "Bars for the rolling R/S estimate on a 1h chart. 221 = bot default (config.py). The optimal window is pair/timeframe specific.",
     group = filter_grp)
hurst_window_4h = input.int(140, "Hurst Window (4h chart)", minval = 18, maxval = 300,
     tooltip = "Bars for the rolling R/S estimate on a 4h chart. 140 = bot default (config.py).",
     group = filter_grp)
hurst_window_other = input.int(100, "Hurst Window (Other TF)", minval = 18, maxval = 300,
     tooltip = "Used for any chart timeframe other than 1h/4h. 100 = the bot's fallback for unknown timeframes.",
     group = filter_grp)
hurst_window = timeframe.period == "60" ? hurst_window_1h : timeframe.period == "240" ? hurst_window_4h : hurst_window_other
hurst_min_dev = input.float(0.12, "Hurst Min Deviation from 0.5",
     minval = 0.0, maxval = 0.5, step = 0.01,
     tooltip = "Trending Only: pass only if (hurst - 0.5) >= this. Symmetric: pass if abs(hurst - 0.5) >= this.",
     group = filter_grp)
hurst_mode = input.string("Trending Only", "Hurst Mode",
     options = ["Trending Only", "Symmetric (Trend + Mean-Rev)"],
     tooltip = "Trending Only matches the trend-following A/U entries (bot default).",
     group = filter_grp)
hurst_bias = input.bool(true, "Hurst Bias Correction (Anis-Lloyd)",
     tooltip = "Subtracts the slope that i.i.d. noise would produce over the same chunk sizes, so pure noise reads ~0.5 at any window. Bot default: on. Turn off to get the legacy (uncorrected) estimate.",
     group = filter_grp)
show_hurst_label = input.bool(false, "Show Hurst Debug Label",
     tooltip = "Shows the current Hurst exponent in the corner of the chart.",
     group = filter_grp)

ai_pro_grp = "AI PRO"
htf = input.timeframe("D", "HTF Bias TF",
     tooltip = "Timeframe for the HTF bias. Uses the last CLOSED candle of this timeframe (bot: 1d).",
     group = ai_pro_grp)
cooldown_bars = input.int(2, "Signal Cooldown (bars after EXIT)",
     minval = 0,
     tooltip = "Minimum bars between the EXIT of a trade and the next signal of the same track and side (bot: COOLDOWN_BARS = 2, armed on exit).",
     group = ai_pro_grp)
enable_ai_regime = input.bool(true, "AI Volatility Regime",
     tooltip = "Regime (CHAOS / TREND / NORMAL) from ATR%. Together with Adaptive Leverage it adjusts the recommended leverage.",
     group = ai_pro_grp)
enable_fake_break = input.bool(true, "Fake Breakout Filter",
     tooltip = "Blocks signals if price broke a 10-bar extreme but closed back inside.",
     group = ai_pro_grp)
enable_liq_sweep = input.bool(true, "Liquidity Sweep Filter",
     tooltip = "Blocks counter-directional signals after a liquidity sweep.",
     group = ai_pro_grp)
enable_mtf_bias = input.bool(true, "Enable HTF Bias",
     tooltip = "Longs only when the last closed HTF candle is above its FRAMA, shorts only when below.",
     group = ai_pro_grp)
enable_adaptive_lev = input.bool(true, "Adaptive Leverage",
     tooltip = "Halves the recommended leverage in CHAOS and raises it x1.2 in TREND.",
     group = ai_pro_grp)

a_grp = "ANDEAN + MFI"
mfi_len = input.int(8, "MFI Length",
     tooltip = "MFI period (bot: 8).",
     group = a_grp)
mfi_training = input.int(800, "AI Training Size",
     tooltip = "Number of closed-bar MFI values the K-Means (2 clusters) levels are trained on (bot: 800).",
     group = a_grp)
kmeans_every = input.int(1, "K-Means Recalc Every N Bars",
     minval = 1,
     tooltip = "1 = retrain on every closed bar, exactly like the bot. Raise to 5 if the chart loads slowly (v4.0 behaviour).",
     group = a_grp)
and_len = input.int(23, "Andean Length",
     tooltip = "Andean oscillator period (bot: 23).",
     group = a_grp)
and_sig_len = input.int(6, "Andean Signal Smoothing",
     tooltip = "Smoothing of the Andean signal line (bot: 6).",
     group = a_grp)
lookback = input.int(3, "Confirmation Window",
     tooltip = "MFI and Andean crossovers must happen within N bars of each other (bot: 3).",
     group = a_grp)

ut_grp = "UT BOT"
ut_a = input.float(1.0, "Key Value (Sensitivity)",
     tooltip = "UT Bot sensitivity (bot: 1.0).",
     group = ut_grp)
ut_c = input.int(10, "ATR Period",
     tooltip = "ATR period for the UT Bot trailing stop (bot: 10).",
     group = ut_grp)
ut_h = input.bool(true, "Heikin Ashi Candles",
     tooltip = "Run UT Bot on Heikin Ashi candles (ATR still from regular candles).",
     group = ut_grp)

frama_grp = "FRAMA CHANNEL"
frama_len = input.int(22, "FRAMA Period (Even value)",
     minval = 4, maxval = 100, step = 2,
     tooltip = "FRAMA period, must be even (bot: 22).",
     group = frama_grp)
frama_mult = input.float(2.1, "Channel Multiplier",
     minval = 0.1, step = 0.1,
     tooltip = "FRAMA channel width in ATR (bot: 2.1).",
     group = frama_grp)
show_frama = input.bool(true, "Show FRAMA Lines",
     tooltip = "Show FRAMA channel lines on the chart.",
     group = frama_grp)
f_up_col = input.color(color.rgb(0, 255, 120), "FRAMA Up Color", group = frama_grp)
f_dn_col = input.color(color.rgb(255, 50, 50), "FRAMA Down Color", group = frama_grp)

chop_grp = "CHOP FILTER"
chop_length = input.int(14, "CHOP Length",
     minval = 1,
     tooltip = "Period for the CHOP index (bot: 14).",
     group = chop_grp)
chop_thr_1h = input.float(55.0, "CHOP Threshold (1h chart)",
     minval = 1.0, maxval = 100.0, step = 0.1,
     tooltip = "Above the threshold = sideways (A/U blocked). Bot default for 1h: 55.0.",
     group = chop_grp)
chop_thr_4h = input.float(61.8, "CHOP Threshold (4h chart)",
     minval = 1.0, maxval = 100.0, step = 0.1,
     tooltip = "Bot default for 4h: 61.8.",
     group = chop_grp)
chop_thr_other = input.float(61.8, "CHOP Threshold (Other TF)",
     minval = 1.0, maxval = 100.0, step = 0.1,
     tooltip = "Used for any other timeframe (bot fallback: 61.8).",
     group = chop_grp)
show_chop_bg = input.bool(true, "Show CHOP Background",
     tooltip = "Orange background during sideways periods.",
     group = chop_grp)

tr_grp = "TRADE ENGINE (mirrors mufca-bot)"
use_auto_params = input.bool(true, "Use Advisor Auto TP/SL",
     tooltip = "ON: adaptive SL (MAE percentile) and adaptive TP1/TP2 learned from this indicator's own closed trades, with the bot's fallbacks while history is thin, plus the min R:R gate. OFF: fixed ATR multiples below (TP1 = TP2, no R:R gate).",
     group = tr_grp)
tp_mult = input.float(1.0, "Fixed Take Profit (xATR)",
     tooltip = "Used only when Advisor Auto TP/SL is OFF.",
     group = tr_grp)
sl_mult = input.float(1.0, "Fixed Stop Loss (xATR)",
     tooltip = "Used only when Advisor Auto TP/SL is OFF.",
     group = tr_grp)
min_rr = input.float(1.5, "Min R:R",
     minval = 0.1,
     tooltip = "Signals whose TP2 / SL distance is below this are rejected (bot: MIN_RR = 1.5). Also the TP2 floor when TP1 is statistical.",
     group = tr_grp)
max_hold = input.int(20, "Max Bars to Hold Position",
     minval = 1, maxval = 500,
     tooltip = "Time stop: closes at the bar close after N bars (bot: MAX_HOLD_BARS = 20), labelled 'cancelled'.",
     group = tr_grp)
tp1_mode = input.string("half_tp1", "SL Move After TP1",
     options = ["breakeven", "quarter_tp1", "half_tp1", "three_quarter_tp1"],
     tooltip = "Where the SL goes once TP1 is touched (50% of the position is modelled as closed at TP1). Bot TP1_SL_MODE; half_tp1 = halfway between entry and TP1.",
     group = tr_grp)
same_bar_tp1 = input.string("tp1_first", "Same-Bar TP1 + SL Policy",
     options = ["tp1_first", "sl_first"],
     tooltip = "When one bar crosses both TP1 and the original SL: tp1_first credits TP1 and exits at the moved SL (sl_after_tp1); sl_first assumes a full loss. Bot: SAME_BAR_TP1_POLICY.",
     group = tr_grp)
max_allowed_lev = input.int(10, "Max Leverage (Limit)",
     minval = 1, maxval = 100,
     tooltip = "Maximum leverage that can be recommended (bot: 10).",
     group = tr_grp)
target_risk_depo = input.float(5.0, "SL Risk (%)",
     minval = 1.0, maxval = 20.0,
     tooltip = "Used to size recommended leverage: int(this / SL distance in ATR) (bot: TARGET_RISK_DEP = 5).",
     group = tr_grp)

adv_grp = "ADVISOR CALIBRATION (state.py)"
sig_hist_limit = input.int(25, "History Window (trades)",
     minval = 5, maxval = 100,
     tooltip = "Most recent trades per track/side used for the TP percentile (bot: SIGNAL_HISTORY_LIMIT = 25).",
     group = adv_grp)
tp_percentile = input.float(0.75, "TP Percentile",
     minval = 0.1, maxval = 0.99, step = 0.01,
     tooltip = "Base weighted-MFE percentile for TP1 (bot: 0.75).",
     group = adv_grp)
tp_auto_adjust = input.bool(true, "TP Hit-Rate Auto Adjust",
     tooltip = "Lowers/raises the percentile based on the real TP hit rate once there are 15+ trades.",
     group = adv_grp)
tp_hit_target = input.float(0.35, "Target TP Hit Rate (fixed)",
     minval = 0.01, maxval = 0.99, step = 0.01,
     tooltip = "Fixed target hit rate, used only when Auto Hit-Rate Target is OFF (bot: 0.35, calibrated for the legacy tp2 metric).",
     group = adv_grp)
tp_capture = input.float(0.70, "TP Capture Rate",
     minval = 0.1, maxval = 1.0, step = 0.05,
     tooltip = "Realistic share of the historical MFE that can be captured (bot: 0.70; softened to 0.85 when the regime discount applies).",
     group = adv_grp)
tp_adj_min = input.float(0.30, "Min Adjusted Percentile", minval = 0.05, maxval = 0.99, step = 0.01, group = adv_grp)
tp_adj_max = input.float(0.85, "Max Adjusted Percentile", minval = 0.05, maxval = 0.99, step = 0.01, group = adv_grp)
min_tp_pct = input.float(0.3, "Min TP (%)",
     tooltip = "Lower clamp of the statistical TP distance (bot: MIN_TP_PCT = 0.3).",
     group = adv_grp)
max_tp_pct = input.float(8.0, "Max TP (%)",
     tooltip = "Upper clamp of the statistical TP distance (bot: MAX_TP_PCT = 8.0).",
     group = adv_grp)
tp1_fb_rr = input.float(2.0, "TP1 Fallback R:R",
     tooltip = "Used while fewer than 3 closed trades exist (bot: 2.0).",
     group = adv_grp)
tp2_fb_rr = input.float(3.0, "TP2 Fallback R:R",
     tooltip = "Used while fewer than 3 closed trades exist (bot: 3.0).",
     group = adv_grp)
sl_adaptive = input.bool(true, "Adaptive SL (MAE)",
     tooltip = "SL from the MAE percentile of this track's winning trades once enough exist; otherwise the bot's FRAMA/1.5xATR stop.",
     group = adv_grp)
sl_mae_pct = input.float(0.85, "SL MAE Percentile",
     minval = 0.1, maxval = 0.99, step = 0.01,
     tooltip = "Bot: SL_MAE_PERCENTILE = 0.85.",
     group = adv_grp)
sl_mae_buf = input.float(0.2, "SL MAE Buffer (%)",
     minval = 0.0, step = 0.05,
     tooltip = "Extra margin added to the percentile (bot: 0.2%).",
     group = adv_grp)
sl_min_hist = input.int(10, "SL Min Winning Trades",
     minval = 1,
     tooltip = "Adaptive SL needs this many winning (tp / cancelled) trades (bot: 10).",
     group = adv_grp)
sl_max_atr = input.float(4.0, "SL Max Distance (xATR)",
     minval = 0.5,
     tooltip = "The adaptive SL cannot be farther than this (bot: 4.0).",
     group = adv_grp)
sl_min_dist = input.float(0.1, "SL Min Distance (%)",
     minval = 0.0, step = 0.05,
     tooltip = "Minimum SL / TP1 distance from entry (bot: SL_MIN_DISTANCE_PCT = 0.1%).",
     group = adv_grp)

tp_hit_metric = input.string("tp1", "TP Hit-Rate Metric", options = ["tp1", "tp2"],
     tooltip = "tp1 = share of exits that reached TP1 (tp or sl_after_tp1) — bot default TP_HIT_RATE_METRIC. tp2 = legacy: share that reached TP2 (sl_after_tp1 counts 0.5).",
     group = adv_grp)
tp_target_auto = input.bool(true, "Auto Hit-Rate Target",
     tooltip = "The target is the hit rate achieved BEFORE the recent history window (bot: TP_HIT_RATE_TARGET_AUTO). Without enough older exits the percentile is left unchanged.",
     group = adv_grp)
tp_auto_min_base = input.int(15, "Auto Target: Min Older Exits",
     minval = 1,
     tooltip = "Older exits required to trust the baseline (bot: TP_AUTO_TARGET_MIN_BASELINE = 15).",
     group = adv_grp)

cap_grp = "TP OBSTACLE CAP (S/R + Volume Profile)"
enable_tp_cap = input.bool(true, "Cap TP2 at Nearest Obstacle",
     tooltip = "TP2 is cut at the nearest significant level between entry and target: an S/R pivot cluster with enough touches, or Volume Profile POC / VAH (long) / VAL (short). Skipped when the capped R:R falls below Min R:R. TP1 is rebuilt proportionally (state.apply_tp_obstacle_cap).",
     group = cap_grp)
ob_depth = input.int(900, "S/R Search Depth (bars)",
     minval = 50, maxval = 4000,
     tooltip = "Closed bars searched for pivots (bot: SR_MIN_LOOKBACK = 900).",
     group = cap_grp)
ob_pivot_w = input.int(10, "S/R Pivot Window",
     minval = 2, maxval = 50,
     tooltip = "Bars on each side of a pivot (bot: SR_PIVOT_WINDOW = 10).",
     group = cap_grp)
ob_max_lv = input.int(4, "S/R Max Levels per Side",
     minval = 1, maxval = 20,
     tooltip = "Clusters kept nearest to price (bot: SR_MAX_LEVELS = 4). Clustering tolerance 0.5%, distance limit 12%.",
     group = cap_grp)
ob_min_touch = input.int(2, "S/R Min Touches",
     minval = 1, maxval = 10,
     tooltip = "Pivots per cluster needed for a level to be able to cap the TP (bot: TP_CAP_MIN_TOUCHES = 2).",
     group = cap_grp)
ob_use_vp = input.bool(true, "Use Volume Profile Levels",
     tooltip = "POC / VAH / VAL of the Volume Profile can cap the TP as well (always significant, like in the bot).",
     group = cap_grp)
ob_vp_lookback = input.int(300, "VP Lookback (bars)",
     minval = 20, maxval = 500,
     tooltip = "Bot: 300.",
     group = cap_grp)
ob_vp_bins = input.int(50, "VP Bins",
     minval = 5, maxval = 200,
     tooltip = "Bot: 50.",
     group = cap_grp)
ob_vp_va = input.float(0.70, "VP Value Area",
     minval = 0.1, maxval = 0.95, step = 0.05,
     tooltip = "Share of volume in the Value Area (bot: 0.70).",
     group = cap_grp)

vph_grp = "VOLUME PROFILE HISTOGRAM"
vp_show = input.bool(true, "Show Volume Profile",
     tooltip = "Draws the profile used by the TP obstacle cap (same lookback / bins / value area as the TP Obstacle Cap group): histogram, POC, VAH and VAL. Built from closed bars only, drawn on the last bar.",
     group = vph_grp)
vp_hist = input.bool(true, "Show Histogram Bars",
     tooltip = "Off = keep only the POC line and the Value Area band (bot: show_histogram).",
     group = vph_grp)
vp_side = input.string("right", "Histogram Side", options = ["right", "left", "last bar"],
     tooltip = "right = in the free space to the right of the last bar. left = at the start of the profile window (300 bars back). last bar = bars grow to the left from the last bar, over the price action (bot: histogram_side left/right).",
     group = vph_grp)
vp_width = input.int(40, "Histogram Width (bars)", minval = 5, maxval = 200,
     tooltip = "Width of the longest bar, in chart bars.",
     group = vph_grp)
vp_col_va = input.color(color.new(color.blue, 40), "Value Area Bars", group = vph_grp, inline = "vpc")
vp_col_out = input.color(color.new(color.gray, 55), "Outside Bars", group = vph_grp, inline = "vpc")
vp_col_poc = input.color(color.orange, "POC", group = vph_grp, inline = "vpl")
vp_col_va_line = input.color(color.new(color.aqua, 20), "VAH / VAL", group = vph_grp, inline = "vpl")

gate_grp = "VOLUME & SAFETY GATES"
use_vol_lev = input.bool(true, "Volume-Flow Leverage Adjustment",
     tooltip = "Adjusts the recommended leverage by the volume-flow score and relative volume: +2 / +1 on confirming flow, -1 / -2 on opposing flow, halved when relative volume < 0.5 (volume_leverage_adjustment_v3).",
     group = gate_grp)
vg_enabled = input.bool(false, "Low-Volume Gate",
     tooltip = "Blocks NEW entries while the signal bar's volume is far below normal for this pair/timeframe. Off by default, like the bot (opt-in).",
     group = gate_grp)
vg_metric = input.string("bar", "Gate Metric", options = ["bar", "smooth", "thin", "how"],
     tooltip = "bar: bar quote volume / median of the previous N days. smooth: mean of the last 3 bars / same baseline. thin: price impact per unit of volume vs baseline. how: quote volume vs the same hour-of-week over the previous 8 weeks. High = liquid; a bar is blocked when below the threshold.",
     group = gate_grp)
vg_thr = input.float(0.5, "Gate Threshold",
     minval = 0.0, maxval = 5.0, step = 0.05,
     tooltip = "Minimum metric value (bot default 0.5; 0 = gate off). Unknown values pass.",
     group = gate_grp)
vg_days = input.int(14, "Gate Baseline (days)",
     minval = 3, maxval = 60,
     tooltip = "Baseline window for the median (bot default 14). The bot only sees ~900 bars, so on small timeframes the window is capped the same way.",
     group = gate_grp)
shock_on = input.bool(true, "Market Shock Guard",
     tooltip = "Detects an abnormal move: |close - close N bars ago| >= multiple x ATR(14) taken at the start of the window (news cascades). Warns in the table and on the chart.",
     group = gate_grp)
shock_bars = input.int(4, "Shock Window (bars)",
     minval = 1, maxval = 50,
     tooltip = "Bot: 4.",
     group = gate_grp)
shock_mult = input.float(5.0, "Shock Size (x ATR)",
     minval = 1.0, step = 0.5,
     tooltip = "Bot: 5.0.",
     group = gate_grp)
shock_block = input.bool(false, "Block Entries During Shock",
     tooltip = "Bot toggle SHOCK_GUARD_BLOCK_ENTRIES (off by default = warn only).",
     group = gate_grp)

sw_grp = "ENTRY SWITCHES"
sw_a_long = input.string("allow", "A Long", options = ["allow", "block_trend", "block_all"],
     tooltip = "allow = open normally. block_trend = skip while the regime is TREND. block_all = never open. (bot: Settings -> Entry switches)",
     group = sw_grp)
sw_a_short = input.string("allow", "A Short", options = ["allow", "block_trend", "block_all"], group = sw_grp)
sw_u_long = input.string("allow", "U Long", options = ["allow", "block_trend", "block_all"], group = sw_grp)
sw_u_short = input.string("allow", "U Short", options = ["allow", "block_trend", "block_all"], group = sw_grp)

visual_grp = "VISUALS"
show_sl_tp = input.bool(true, "Show SL/TP Lines",
     tooltip = "Show TP2 (crosses), TP1 (circles) and SL (red crosses) of the open trade of each track.",
     group = visual_grp)
show_exits = input.bool(true, "Show Exit / TP1 Markers",
     tooltip = "Small markers on the bar where a trade hits TP1, TP2, SL, sl_after_tp1 or the time stop.",
     group = visual_grp)
show_table = input.bool(true, "Show Table",
     tooltip = "Show the information table.",
     group = visual_grp)
table_pos = input.string("Top Right", "Table Position",
     options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"],
     group = visual_grp)
a_buy_col = input.color(color.new(color.teal, 20), "A Buy", group = visual_grp, inline = "acol")
a_sell_col = input.color(color.new(color.maroon, 20), "A Sell", group = visual_grp, inline = "acol")
u_buy_col = input.color(color.green, "U Buy", group = visual_grp, inline = "ucol")
u_sell_col = input.color(color.red, "U Sell", group = visual_grp, inline = "ucol")
a_tp_col = input.color(color.teal, "A TP", group = visual_grp, inline = "tpsl")
u_tp_col = input.color(color.lime, "U TP", group = visual_grp, inline = "tpsl")
sl_col = input.color(color.red, "SL Line", group = visual_grp, inline = "tpsl")

bb_grp = "BOLLINGER BANDS"
